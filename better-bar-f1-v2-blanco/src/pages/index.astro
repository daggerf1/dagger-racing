
---
// src/pages/index.astro

import NewsCard from "../components/NewsCard.astro";
import MenuNav from "../components/MenuNav.astro";
import Footer from "../components/Footer.astro";

import {
  getPublishedArticles,
} from "../lib/content/articles";

const todasLasNoticias = await getPublishedArticles();

const noticiaPrincipal = todasLasNoticias[0];

// DRN-CARRUSEL-NOTICIAS-MOVIL-2026
const noticiasCarrusel = todasLasNoticias.slice(0, 5);


const notasSecundarias = todasLasNoticias.filter(
  (nota) => nota.id !== noticiaPrincipal?.id
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("es-MX", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
import RacePodium from "../components/motorsport/RacePodium.astro";
import "../../public/css/drn-motorsport-pro.css";
---

<!DOCTYPE html>
<html lang="es">

  <head>
    <!-- DRN-FAVICON-GOOGLE -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6167283917185567" crossorigin="anonymous"></script>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Dagger Racing News | Portal F1</title>

    <meta
      name="description"
      content="Noticias, crónicas y análisis de Fórmula 1 en Dagger Racing News."
    />

    <link
      rel="stylesheet"
      href="/css/global.css"
    />
  
    <!-- DRN-NIGHT-RACING -->
    <link rel="stylesheet" href="/css/drn-night-racing.css" />
</head>

  <body>

    <!-- =========================
         HEADER
    ========================= -->

    <header class="top-header">

      <div class="top-red-line"></div>

      <div class="top-nav">
        <MenuNav />
      </div>

    </header>


    <!-- =========================
         CONTENIDO PRINCIPAL
    ========================= -->

    <main class="container drn-home-mobile">

      
<RacePodium />

<div class="drn-editorial-grid">

      <!-- DRN-CARRUSEL-NOTICIAS-MOVIL-2026 -->
      {
        noticiasCarrusel.length > 0 && (
          <section
            class="drn-mobile-news-carousel drn-carousel-photo-dots"
            aria-label="Noticias destacadas"
            data-drn-carousel
          >
            <div class="drn-carousel-viewport" data-drn-carousel-viewport>
              {
                noticiasCarrusel.map((nota, index) => {
                  const imagen = nota.data.image
                    ? nota.data.image.startsWith("/")
                      ? nota.data.image
                      : `/images/${nota.data.image}`
                    : "";

                  return (
                    <article
                      class="drn-carousel-slide"
                      data-drn-carousel-slide
                      aria-label={`Noticia ${index + 1} de ${noticiasCarrusel.length}`}
                    >
                      <a
                        class="drn-carousel-link"
                        href={`/noticias/${nota.data.slug}/`}
                      >
                        {imagen && (
                          <img
                            src={imagen}
                            alt={nota.data.title}
                            loading={index === 0 ? "eager" : "lazy"}
                          />
                        )}
</a>
                    </article>
                  );
                })
              }
            </div>

            <div
              class="drn-carousel-indicators"
              aria-label="Seleccionar noticia destacada"
            >
              {
                noticiasCarrusel.map((_, index) => (
                  <button
                    type="button"
                    class:list={[
                      "drn-carousel-indicator",
                      { "is-active": index === 0 },
                    ]}
                    data-drn-carousel-indicator
                    data-index={index}
                    aria-label={`Mostrar noticia ${index + 1}`}
                    aria-current={index === 0 ? "true" : undefined}
                  ></button>
                ))
              }
            </div>
          
            <!-- DRN-TITULAR-FIJO-CARRUSEL-2026 -->
            <div class="drn-carousel-static-caption">
              {
                noticiasCarrusel.map((nota, index) => (
                  <a
                    class:list={[
                      "drn-carousel-static-title",
                      { "is-active": index === 0 },
                    ]}
                    href={`/noticias/${nota.data.slug}/`}
                    data-drn-carousel-title
                    aria-hidden={index === 0 ? "false" : "true"}
                    tabindex={index === 0 ? 0 : -1}
                  >
                    <span class="drn-carousel-label">
                      FÓRMULA 1
                    </span>
                    <h2>{nota.data.title}</h2>
                  </a>
                ))
              }
            </div>

          </section>
        )
      }


      
      <aside class="drn-desktop-latest" aria-label="Últimas noticias">
        <h2>Últimas noticias</h2>

        {todasLasNoticias.slice(5, 9).map((nota) => (
          <a
            class="drn-desktop-latest-card"
            href={`/noticias/${nota.data.slug}/`}
          >
            {nota.data.image && (
              <img
                src={nota.data.image.startsWith("/")
                  ? nota.data.image
                  : `/images/${nota.data.image}`}
                alt={nota.data.title}
                loading="lazy"
              />
            )}
            <div>
              <time datetime={nota.data.publishedAt.toISOString()}>
                {formatDate(nota.data.publishedAt)}
              </time>
              <h3>{nota.data.title}</h3>
            </div>
          </a>
        ))}
      </aside>

      </div>

<!-- CRÓNICA DESTACADA -->

      <div class="drn-cronica-destacada-desktop">
<div class="section-header">
        <h2>Crónica Destacada</h2>
      </div>

      {
        noticiaPrincipal && (

          <section class="headline-article">

            <a
              class="headline-image-area"
              style={
                noticiaPrincipal.data.image
                  ? `background-image:url(${
                      noticiaPrincipal.data.image.startsWith("/")
                        ? noticiaPrincipal.data.image
                        : `/images/${noticiaPrincipal.data.image}`
                    }); background-size:contain; background-position:center; background-repeat:no-repeat; background-color:transparent;`
                  : undefined
              }
            
              href={`/noticias/${noticiaPrincipal.data.slug}/`}
              aria-label={`Leer noticia: ${noticiaPrincipal.data.title}`}
            ></a>

            <div class="headline-content">

              <div class="meta-row">

                <span class="badge-date">
                  {formatDate(
                    noticiaPrincipal.data.publishedAt
                  )}
                </span>

                <span class="category-text">
                  {
                    (noticiaPrincipal.data.category === "formula-1" || noticiaPrincipal.data.slug === "bianca-leclerc-familia-ferrari-2026")
                      ? "FÓRMULA 1"
                      : noticiaPrincipal.data.category
                          .replaceAll("-", " ")
                          .toUpperCase()
                  }
                </span>

              </div>

              <h3 class="title-main">
                <a
                  href={`/noticias/${noticiaPrincipal.data.slug}/`}
                  style="color:inherit;text-decoration:none;"
                >
                  {noticiaPrincipal.data.title}
                </a>
              </h3>

              <p class="excerpt">
                {
                  noticiaPrincipal.data.description ??
                  "Haga clic abajo para leer la crónica completa y el análisis."
                }
              </p>

              <a
                class="btn-read-more"
                href={`/noticias/${noticiaPrincipal.data.slug}/`}
              >
                LEER CRÓNICA COMPLETA ➜
              </a>

            </div>

          </section>

        )
      }


      </div>

      <!-- =========================
           CRÓNICAS ANTERIORES
      ========================= -->

      
<!-- DRN-MOTORSPORT-PRO-INICIO -->

<!-- DRN-MOTORSPORT-PRO-FIN -->
<div class="section-header">
        <h2>Crónicas Anteriores</h2>
      </div>

      <section class="news-feed">

        {
          notasSecundarias.map((nota, index) => (
            <div class:list={[
              "drn-editorial-feed-item",
              { "drn-editorial-repeated": index < 8 }
            ]}>

            <NewsCard
              fecha={formatDate(
                nota.data.publishedAt
              )}

              categoria={
                (nota.data.category === "formula-1" || nota.data.slug === "bianca-leclerc-familia-ferrari-2026")
                  ? "FÓRMULA 1"
                  : nota.data.category
                      .replaceAll("-", " ")
                      .toUpperCase()
              }

              titulo={nota.data.title}

              extracto={
                nota.data.description ??
                "Toda la actualidad de la Fórmula 1."
              }

              fotoCredito=""

              link={`/noticias/${nota.data.slug}/`}

              imagen={
                nota.data.image
                  ? nota.data.image.startsWith("/")
                    ? nota.data.image
                    : `/images/${nota.data.image}`
                  : ""
              }
            />
            </div>

          ))
        }

      </section>

    </main>


    <!-- =========================
         FOOTER OFICIAL DAGGER
    ========================= -->

    <Footer />

  
<style>
  /* DRN-CARRUSEL-NOTICIAS-MOVIL-2026 */
  .drn-mobile-news-carousel {
    display: none;
  }

  @media screen and (max-width: 850px) {
    .drn-mobile-news-carousel {
      display: block;
      width: 100%;
      margin: 0 0 26px;
      overflow: hidden;
      background: #101014;
    }

    .drn-carousel-viewport {
      display: flex;
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
    }

    .drn-carousel-viewport::-webkit-scrollbar {
      display: none;
    }

    .drn-carousel-slide {
      flex: 0 0 100%;
      min-width: 0;
      scroll-snap-align: start;
      position: relative;
      background: #101014;
    }

    .drn-carousel-link {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      color: #fff;
      text-decoration: none;
    }

    .drn-carousel-link img {
      display: block;
      width: 100%;
      height: 215px;
      object-fit: cover;
    }

    .drn-carousel-caption {
      padding: 15px 17px 18px;
      background: #101014;
      color: #fff;
    }

    .drn-carousel-label {
      display: block;
      margin-bottom: 8px;
      color: #ff3737;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .drn-carousel-caption h2 {
      margin: 0;
      color: #fff;
      font-size: clamp(17px, 4.5vw, 22px);
      font-weight: 800;
      line-height: 1.3;
    }

    .drn-carousel-indicators {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 7px;
      padding: 12px;
      background: #101014;
    }

    .drn-carousel-indicator {
      appearance: none;
      -webkit-appearance: none;
      display: block;
      flex: 0 0 auto;
      width: 25px;
      height: 4px;
      padding: 0;
      border: 0;
      border-radius: 4px;
      background: #777780;
      cursor: pointer;
      transition: width .2s ease, background .2s ease;
    }

    .drn-carousel-indicator.is-active {
      width: 44px;
      background: #e02020;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drn-carousel-viewport {
      scroll-behavior: auto;
    }

    .drn-carousel-indicator {
      transition: none;
    }
  }
</style>


<script is:inline>
  // DRN-CARRUSEL-NOTICIAS-MOVIL-2026
  (() => {
    const carousel = document.querySelector("[data-drn-carousel]");
    if (!carousel) return;

    const viewport = carousel.querySelector("[data-drn-carousel-viewport]");
    const slides = Array.from(
      carousel.querySelectorAll("[data-drn-carousel-slide]")
    );
    const indicators = Array.from(
      carousel.querySelectorAll("[data-drn-carousel-indicator]")
    );

    if (!viewport || !slides.length) return;

    const titles = Array.from(
      carousel.querySelectorAll("[data-drn-carousel-title]")
    );

    const activate = (index) => {
      titles.forEach((title, i) => {
        const active = i === index;
        title.classList.toggle("is-active", active);
        title.setAttribute("aria-hidden", String(!active));
        title.tabIndex = active ? 0 : -1;
      });

      indicators.forEach((button, i) => {
        const active = i === index;
        button.classList.toggle("is-active", active);

        if (active) {
          button.setAttribute("aria-current", "true");
        } else {
          button.removeAttribute("aria-current");
        }
      });
    };

    indicators.forEach((button, index) => {
      button.addEventListener("click", () => {
        viewport.scrollTo({
          left: slides[index].offsetLeft - slides[0].offsetLeft,
          behavior: window.matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches ? "auto" : "smooth",
        });
        activate(index);
      });
    });

    let ticking = false;

    viewport.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;

      requestAnimationFrame(() => {
        const width = viewport.clientWidth;
        if (width > 0) {
          const index = Math.max(
            0,
            Math.min(slides.length - 1, Math.round(viewport.scrollLeft / width))
          );
          activate(index);
        }
        ticking = false;
      });
    }, { passive: true });
  })();
</script>


<style>
  /* DRN-INDICADORES-SOBRE-FOTOGRAFIA-2026 */
  @media screen and (max-width: 850px) {
    .drn-carousel-photo-dots {
      position: relative;
    }

    .drn-carousel-photo-dots .drn-carousel-indicators {
      position: absolute;
      top: 191px;
      left: 0;
      right: 0;
      z-index: 5;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 10px 12px;
      margin: 0;
      background: transparent;
    }

    .drn-carousel-photo-dots .drn-carousel-indicator {
      background: rgba(255, 255, 255, .7);
      box-shadow: 0 1px 4px rgba(0, 0, 0, .55);
    }

    .drn-carousel-photo-dots .drn-carousel-indicator.is-active {
      background: #e02020;
    }
  }
</style>


<style>
  /* DRN-OCULTAR-CRONICA-DUPLICADA-MOVIL-2026 */
  @media screen and (max-width: 850px) {
    .drn-cronica-destacada-desktop {
      display: none !important;
    }
  }
</style>


<style>
  /* DRN-TITULAR-FIJO-CARRUSEL-2026 */
  @media screen and (max-width: 850px) {
    .drn-carousel-static-caption {
      position: relative;
      width: 100%;
      background: #101014;
      padding: 15px 17px 18px;
      box-sizing: border-box;
    }

    .drn-carousel-static-title {
      display: none;
      color: #ffffff;
      text-decoration: none;
    }

    .drn-carousel-static-title.is-active {
      display: block;
    }

    .drn-carousel-static-title h2 {
      margin: 0;
      color: #ffffff;
      font-size: clamp(17px, 4.5vw, 22px);
      font-weight: 800;
      line-height: 1.3;
    }
  }
</style>


<style>
/* DRN-EDITORIAL-DESKTOP-2026 */

.drn-desktop-latest {
  display: none;
}

.drn-editorial-grid,
.drn-editorial-feed-item {
  display: contents;
}

@media screen and (min-width: 851px) {

  main.drn-home-mobile {
    width: min(1200px, calc(100% - 48px));
    margin: 30px auto 0;
  }

  .drn-editorial-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.25fr) minmax(0, 1fr);
    gap: 26px;
    align-items: start;
  }

  .drn-cronica-destacada-desktop {
    display: none !important;
  }

  .drn-mobile-news-carousel {
    --drn-photo-height: clamp(280px, 33vw, 450px);
    display: block !important;
    position: relative;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    background: #101014;
    border-radius: 6px;
  }

  .drn-carousel-viewport {
    display: flex;
    width: 100%;
    height: var(--drn-photo-height);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .drn-carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  .drn-carousel-slide {
    flex: 0 0 100%;
    min-width: 0;
    position: relative;
    scroll-snap-align: start;
  }

  .drn-carousel-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .drn-carousel-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Indicadores sobre la fotografía */

  .drn-carousel-indicators {
    position: absolute;
    top: calc(var(--drn-photo-height) - 36px);
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 36px;
    background: transparent;
  }

  .drn-carousel-indicator {
    position: relative;
    appearance: none;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .drn-carousel-indicator::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 13px;
    height: 4px;
    border-radius: 4px;
    background: rgba(255,255,255,.75);
    box-shadow: 0 1px 4px #000;
  }

  .drn-carousel-indicator.is-active {
    width: 48px;
  }

  .drn-carousel-indicator.is-active::after {
    background: #e10600;
  }

  /* Panel negro independiente */

  .drn-carousel-static-caption {
    display: grid;
    padding: 22px 25px 26px;
    background: #101014;
    color: #fff;
  }

  .drn-carousel-static-title {
    grid-area: 1 / 1;
    visibility: hidden;
    color: #fff;
    text-decoration: none;
  }

  .drn-carousel-static-title.is-active {
    visibility: visible;
  }

  .drn-carousel-label {
    display: block;
    color: #ff4545;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.2px;
    margin-bottom: 10px;
  }

  .drn-carousel-static-title h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 900;
    line-height: 1.2;
  }

  .drn-carousel-static-title:hover h2 {
    color: #ff4545;
  }

  /* Columna lateral */

  .drn-desktop-latest {
    display: block;
    min-width: 0;
  }

  .drn-desktop-latest > h2 {
    margin: 0 0 12px;
    padding: 0 0 12px;
    border-bottom: 3px solid #e10600;
    font-size: 21px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .drn-desktop-latest-card {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid #ddd;
    color: #151515;
    text-decoration: none;
  }

  .drn-desktop-latest-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 3px;
  }

  .drn-desktop-latest-card time {
    display: block;
    margin-bottom: 5px;
    color: #777;
    font-size: 10px;
  }

  .drn-desktop-latest-card h3 {
    font-size: 14px;
    line-height: 1.35;
    font-weight: 800;
  }

  .drn-desktop-latest-card:hover h3 {
    color: #e10600;
  }

  /* Evitar repetir las noticias de arriba */

  .drn-editorial-repeated {
    display: none !important;
  }
}

@media screen and (min-width: 851px)
and (prefers-reduced-motion: reduce) {
  .drn-carousel-viewport {
    scroll-behavior: auto;
  }
}
</style>

</body>

</html>

<style>
/* DRN-ENCABEZADO-COMPACTO-DESKTOP-2026 */

@media screen and (min-width: 851px) {
  main.drn-home-mobile {
    margin-top: 20px !important;
  }
}
</style>
