---
import MenuNav from "../components/MenuNav.astro";
import Footer from "../components/Footer.astro";
import standings from "../data/f1-drivers-champions.json";
import constructors from "../data/f1-constructors-championship.json";
import drivers from "../data/editorial/drivers.json";
import { slugifyTeam } from "../lib/f1";
const driverMap=Object.fromEntries(drivers.map(d=>[d.id,d]));
const flags={"alexander-albon":"🇹🇭","fernando-alonso":"🇪🇸","kimi-antonelli":"🇮🇹","oliver-bearman":"🇬🇧","gabriel-bortoleto":"🇧🇷","valtteri-bottas":"🇫🇮","franco-colapinto":"🇦🇷","pierre-gasly":"🇫🇷","isack-hadjar":"🇫🇷","lewis-hamilton":"🇬🇧","nico-hulkenberg":"🇩🇪","liam-lawson":"🇳🇿","charles-leclerc":"🇲🇨","arvid-lindblad":"🇬🇧","lando-norris":"🇬🇧","esteban-ocon":"🇫🇷","sergio-perez":"🇲🇽","oscar-piastri":"🇦🇺","george-russell":"🇬🇧","carlos-sainz":"🇪🇸","lance-stroll":"🇨🇦","max-verstappen":"🇳🇱"};
const pilotos=standings.map(s=>({...s,nombre:driverMap[s.driverId]?.name??s.driverId,bandera:flags[s.driverId]??"🏁",teamSlug:slugifyTeam(s.team)}));
import ChampionshipChart from "../components/motorsport/ChampionshipChart.astro";
import "../../public/css/drn-motorsport-pro.css";

import fs from "node:fs";
import path from "node:path";
import races from "../data/f1-data.json";

const colores: Record<string, string> = {
    "mercedes": "#00d2be",
    "ferrari": "#ff3535",
    "red-bull-racing": "#5478ff",
    "mclaren": "#ff8000",
    "racing-bulls": "#819aff",
    "alpine": "#ff87bc",
    "haas-f1-team": "#d5d5d5",
    "audi": "#d94343",
    "williams": "#64a4ff",
    "aston-martin": "#229971",
    "cadillac": "#c4bbaa"
};

function colorEquipo(team: string) {
    return colores[slugifyTeam(team)] ?? "#aeb4bf";
}

function nombrePiloto(id: string, nombre: string) {
    if (nombre !== id) return nombre;
    return id.split("-")
        .map(p => p.charAt(0).toUpperCase() + p.slice(1))
        .join(" ");
}

function imagenMonoplaza(id: string) {
    const apellido = id.split("-").pop() ?? "";
    const nombre = `monoplaza_${apellido}_drn_daggerracingnews.png`;

    return fs.existsSync(
        path.join(process.cwd(), "public", nombre)
    ) ? `/${nombre}` : "";
}

const listaPilotos = [...pilotos]
    .sort((a,b) => a.position - b.position);

const listaEquipos = [...constructors]
    .sort((a,b) => a.position - b.position);

const liderPilotos = listaPilotos[0];
const liderEquipos = listaEquipos[0];

const grupos = [
    {
        id: "drivers",
        label: "PILOTO",
        nombre: nombrePiloto(
            liderPilotos.driverId,
            liderPilotos.nombre
        ),
        equipo: liderPilotos.team,
        puntos: liderPilotos.points,
        ventaja: liderPilotos.points -
            (listaPilotos[1]?.points ?? liderPilotos.points),
        color: colorEquipo(liderPilotos.team),
        imagen: imagenMonoplaza(liderPilotos.driverId),
        href: `/piloto/${liderPilotos.driverId}/`,
        filas: listaPilotos.map(p => ({
            posicion: p.position,
            nombre: nombrePiloto(p.driverId, p.nombre),
            equipo: p.team,
            bandera: p.bandera,
            puntos: p.points,
            color: colorEquipo(p.team),
            href: driverMap[p.driverId]
                ? `/piloto/${p.driverId}/` : "",
            equipoHref: `/equipo/${p.teamSlug}/`
        }))
    },
    {
        id: "teams",
        label: "ESCUDERÍA",
        nombre: liderEquipos.team,
        equipo: "",
        puntos: liderEquipos.points,
        ventaja: liderEquipos.points -
            (listaEquipos[1]?.points ?? liderEquipos.points),
        color: colorEquipo(liderEquipos.team),
        imagen: imagenMonoplaza(
            listaPilotos.find(
                p => slugifyTeam(p.team) === liderEquipos.teamId
            )?.driverId ?? ""
        ),
        href: `/equipo/${liderEquipos.teamId}/`,
        filas: listaEquipos.map(t => ({
            posicion: t.position,
            nombre: t.team,
            equipo: "",
            bandera: "",
            puntos: t.points,
            color: colorEquipo(t.team),
            href: `/equipo/${t.teamId}/`,
            equipoHref: ""
        }))
    }
];

const totalCarreras = races.length;

const carrerasDisputadas = races.filter(
    r => new Date(r.raceEndUTC).getTime() <= Date.now()
).length;

const progreso = totalCarreras
    ? carrerasDisputadas / totalCarreras * 100
    : 0;


---
<!doctype html><html lang="es"><head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6167283917185567" crossorigin="anonymous"></script><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Campeonato F1 2026 | Dagger Racing News</title><link rel="stylesheet" href="/css/styless.css">
<link rel="stylesheet" href="/css/drn-paddock-premium.css" />

    <!-- DRN-NIGHT-RACING -->
    <link rel="stylesheet" href="/css/drn-night-racing.css" />
</head>

<body class="drn-paddock drn-paddock-campeonato">

<MenuNav />

<!-- DRN-IDENTITY-INICIO -->

<div class="drn-identity-banner">
    <a href="/" aria-label="Dagger Racing News - Inicio">
        <img
            src="/encabezado-dagger-web-1600x200.webp"
            alt="Dagger Racing News"
            decoding="async"
        />
    </a>
</div>

<div class="drn-identity-route">
    <span><a href="/">INICIO</a> / CAMPEONATO</span>
    <strong>FÓRMULA 1 · 2026</strong>
</div>

<!-- DRN-IDENTITY-FIN -->



<main class="drn-world">

    <header class="dw-header">

        <div class="dw-brand">
            <span>DRN / CHAMPIONSHIP</span>
            <span>TEMPORADA 2026</span>
        </div>

        <h1>CAMPEONATO MUNDIAL</h1>

    </header>

    <section class="dw-progress">

        <span class="dw-muted">
            PROGRESO DE LA TEMPORADA
        </span>

        <div class="dw-progress-info">
            <strong>
                {carrerasDisputadas} / {totalCarreras}
            </strong>
            <span>GRANDES PREMIOS</span>
        </div>

        <div class="dw-progress-track"
             role="progressbar"
             aria-label="Progreso de temporada"
             aria-valuenow={carrerasDisputadas}
             aria-valuemin="0"
             aria-valuemax={totalCarreras}>

            <div style={`width:${progreso}%`}></div>

        </div>

    </section>

    <nav class="dw-tabs"
         role="tablist"
         aria-label="Clasificaciones">

        <button type="button"
                id="dw-tab-drivers"
                role="tab"
                aria-selected="true"
                aria-controls="dw-drivers"
                data-dw-tab="drivers">

            PILOTOS

        </button>

        <button type="button"
                id="dw-tab-teams"
                role="tab"
                aria-selected="false"
                aria-controls="dw-teams"
                tabindex="-1"
                data-dw-tab="teams">

            CONSTRUCTORES

        </button>

    </nav>

    {grupos.map(grupo => (

        <section class="dw-panel"
                 id={`dw-${grupo.id}`}
                 role="tabpanel"
                 aria-labelledby={`dw-tab-${grupo.id}`}
                 hidden={grupo.id !== "drivers"}>

            <article class="dw-leader"
                     style={`--dw-team:${grupo.color}`}>

                <div class="dw-leader-info">

                    <span class="dw-leader-label">
                        01 / LÍDER DEL MUNDIAL
                    </span>

                    <h2>
                        <a href={grupo.href}>
                            {grupo.nombre}
                        </a>
                    </h2>

                    {grupo.equipo && (
                        <span class="dw-muted">
                            {grupo.equipo}
                        </span>
                    )}

                    <div class="dw-leader-points">
                        {grupo.puntos}
                        <small>PTS</small>
                    </div>

                    <span class="dw-advantage">
                        {grupo.ventaja > 0
                            ? `+${grupo.ventaja} puntos de ventaja`
                            : "Empate en puntos"}
                    </span>

                </div>

                {grupo.imagen && (
                    <div class="dw-leader-image">
                        <img src={grupo.imagen}
                             alt={`Monoplaza de ${grupo.nombre}`}
                             decoding="async" />
                    </div>
                )}

            </article>

            <div class="dw-table">

                <div class="dw-table-head">
                    <span>POS</span>
                    <span>{grupo.label}</span>
                    <span>BRECHA</span>
                    <span>PTS</span>
                </div>

                {grupo.filas.map(fila => (

                    <article class="dw-row"
                             style={`--dw-team:${fila.color}`}>

                        <div class="dw-row-info">

                            <strong class="dw-position">
                                {String(fila.posicion).padStart(2,"0")}
                            </strong>

                            <div class="dw-identity">

                                <span class="dw-name">

                                    {fila.bandera && (
                                        <span class="dw-flag">
                                            {fila.bandera}
                                        </span>
                                    )}

                                    {fila.href ? (
                                        <a href={fila.href}>
                                            {fila.nombre}
                                        </a>
                                    ) : fila.nombre}

                                </span>

                                {fila.equipo && (
                                    <a class="dw-team-name"
                                       href={fila.equipoHref}>
                                        {fila.equipo}
                                    </a>
                                )}

                            </div>

                            <span class="dw-gap">

                                {fila.posicion === 1
                                    ? "—"
                                    : grupo.puntos === fila.puntos
                                    ? "0"
                                    : `−${grupo.puntos - fila.puntos}`}

                            </span>

                            <strong class="dw-points">
                                {fila.puntos}
                            </strong>

                        </div>

                        <div class="dw-points-track"
                             aria-hidden="true">

                            <div style={`width:${
                                grupo.puntos > 0
                                    ? fila.puntos / grupo.puntos * 100
                                    : 0
                            }%`}></div>

                        </div>

                    </article>

                ))}

            </div>

            <p class="dw-note">
                Brecha de puntos respecto al líder del campeonato.
            </p>

        </section>

    ))}

    <!-- DRN-MOTORSPORT-PRO-INICIO -->
    <ChampionshipChart />
    <!-- DRN-MOTORSPORT-PRO-FIN -->

</main>



<!-- DRN-SIGNATURE-INICIO -->

<div class="drn-identity-signature">
    DAGGER RACING NEWS
</div>

<!-- DRN-SIGNATURE-FIN -->

<Footer />

<script is:inline>
    (() => {

        const tabs = Array.from(
            document.querySelectorAll("[data-dw-tab]")
        );

        const panels = document.querySelectorAll(
            ".dw-panel"
        );

        function seleccionar(tab) {

            tabs.forEach(button => {
                const activo = button === tab;

                button.setAttribute(
                    "aria-selected",
                    String(activo)
                );

                button.tabIndex = activo ? 0 : -1;
            });

            panels.forEach(panel => {
                panel.hidden =
                    panel.id !== `dw-${tab.dataset.dwTab}`;
            });
        }

        tabs.forEach((tab, index) => {

            tab.addEventListener("click", () => {
                seleccionar(tab);
            });

            tab.addEventListener("keydown", event => {

                let destino;

                if (event.key === "ArrowRight") {
                    destino = (index + 1) % tabs.length;
                } else if (event.key === "ArrowLeft") {
                    destino = (index - 1 + tabs.length) % tabs.length;
                } else if (event.key === "Home") {
                    destino = 0;
                } else if (event.key === "End") {
                    destino = tabs.length - 1;
                } else {
                    return;
                }

                event.preventDefault();

                seleccionar(tabs[destino]);
                tabs[destino].focus();
            });

        });

    })();
</script>

</body>
</html>

<style is:global>

