---
import { getCollection, render } from "astro:content";
import NoticiaLayout from "../../layouts/NoticiaLayout.astro";

export async function getStaticPaths() {
  const noticias = await getCollection(
    "noticias",
    ({ data }) => data.status === "published"
  );

  return noticias.map((noticia) => ({
    params: {
      slug: noticia.data.slug,
    },
    props: {
      noticia,
    },
  }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);
---

<NoticiaLayout
  title={noticia.data.title}
  description={noticia.data.description}
  publishedAt={noticia.data.publishedAt}
  updatedAt={noticia.data.updatedAt}
  author={noticia.data.author}
  category={noticia.data.category}
  subcategory={noticia.data.subcategory}
  image={noticia.data.image}
  imageAlt={noticia.data.imageAlt}
  drivers={noticia.data.drivers}
  teams={noticia.data.teams}
  tags={noticia.data.tags}
>
  <Content />
</NoticiaLayout>
