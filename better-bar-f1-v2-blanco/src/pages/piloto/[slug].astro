
---
import MenuNav from "../../components/MenuNav.astro";
import Footer from "../../components/Footer.astro";

import drivers from "../../data/editorial/drivers.json";
import standings from "../../data/f1-drivers-champions.json";

import { slugifyTeam } from "../../lib/f1";
import { getArticlesByDriver } from "../../lib/content/articles";

export function getStaticPaths() {
    return drivers
        .filter((driver) => driver.active)
        .map((driver) => ({
            params: {
                slug: driver.slug,
            },
            props: {
                driver,
            },
        }));
}

const { driver } = Astro.props;

const standing = standings.find(
    (item) => item.driverId === driver.id
);

/*
 * Las noticias ya llegan ordenadas
 * de más reciente a más antigua.
 */
const related = await getArticlesByDriver(driver.slug);

const formatDate = (date: Date) =>
    new Intl.DateTimeFormat("es-MX", {
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(date);


/*
====================================================
  FOTOGRAFÍAS Y DERECHOS DE AUTOR
====================================================

CONFIGURACIÓN GENERAL:

- Fotografías de máximo 850 píxeles de ancho.
- Fotografías centradas.
- Sin recortes.
- Adaptables a móviles.
- Créditos debajo de la fotografía.
- Créditos alineados al extremo DERECHO.
- Tamaño de letra de 9 píxeles.
- Enlaces clicables.

PARA AÑADIR FOTOGRAFÍAS:

1. Guarda la imagen en public/.

2. Busca el nombre del piloto.

3. Completa los campos:

imagen:
    Ruta de la fotografía.

credito:
    Fotógrafo y fuente original.

adaptacion:
    Información sobre la adaptación.

licencia:
    Enlace a la licencia.

original:
    Enlace a la fotografía original.

Si no hay imagen, deja los campos vacíos.

No inventes atribuciones ni licencias.

====================================================
*/

