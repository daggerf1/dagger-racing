
---
import MenuNav from "../../components/MenuNav.astro";
import Footer from "../../components/Footer.astro";

import drivers from "../../data/editorial/drivers.json";
import standings from "../../data/f1-drivers-champions.json";

import { slugifyTeam } from "../../lib/f1";
import { getArticlesByDriver } from "../../lib/content/articles";

export function getStaticPaths() {
    return drivers
        .filter((driver) => driver.active)
        .map((driver) => ({
            params: {
                slug: driver.slug,
            },
            props: {
                driver,
            },
        }));
}

const { driver } = Astro.props;

const standing = standings.find(
    (item) => item.driverId === driver.id
);

const related = await getArticlesByDriver(driver.slug);

const formatDate = (date: Date) =>
    new Intl.DateTimeFormat("es-MX", {
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(date);

/*
====================================================
  IMÁGENES Y CRÉDITOS — PERFILES DE PILOTOS
====================================================

INSTRUCCIONES:

1. Guarda las fotografías en la carpeta public/.

2. Busca el nombre del piloto aquí abajo.

3. En "imagen", escribe la ruta de su fotografía.

4. En "credito", escribe el fotógrafo, agencia
   o titular de los derechos correspondiente.

EJEMPLO:

"charles-leclerc": {
    imagen: "/foto-original-de-charles.png",
    credito: "© Fotógrafo / Agencia"
},

Si todavía no tienes una fotografía, deja:

imagen: "",
credito: "",

La página seguirá funcionando normalmente.

IMPORTANTE:
No inventes créditos. Utiliza los datos reales
de autoría o licencia de cada imagen.

====================================================
*/

const fotosPilotos: Record<
