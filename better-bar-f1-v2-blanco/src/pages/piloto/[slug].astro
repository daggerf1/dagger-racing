/*
====================================================
  SELECCIÓN AUTOMÁTICA DE FOTOGRAFÍA
====================================================
*/

const fotoVacia: FotoPiloto = {
    imagen: "",
    credito: "",
    adaptacion: "",
    licencia: "",
    original: "",
};

function obtenerFotoPiloto(
    piloto: typeof driver
): FotoPiloto {

    const slug = String(piloto.slug).toLowerCase();
    const nombre = String(piloto.name).toLowerCase();

    if (nombre.includes("antonelli")) {
        return fotosPilotos["kimi-antonelli"];
    }

    return fotosPilotos[slug] || fotoVacia;
}

const fotoPiloto = obtenerFotoPiloto(driver);

const tieneCreditos = Boolean(
    fotoPiloto.credito ||
    fotoPiloto.adaptacion ||
    fotoPiloto.licencia ||
    fotoPiloto.original
);
---

<!doctype html>

<html lang="es">

<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6167283917185567" crossorigin="anonymous"></script>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>
        {driver.name} | Dagger Racing News
    </title>

    <link
        rel="stylesheet"
        href="/css/styless.css"
    />

    <link
        rel="icon"
        type="image/png"
        href="/daggerracingnews-logotipo.png"
    />

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    />

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />

    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    />

</head>


<body>

    <MenuNav />


    <main class="profile">

        <!-- =====================================
             FOTOGRAFÍA DEL PILOTO
             ===================================== -->

        {
            fotoPiloto.imagen && (

                <figure class="driver-photo">

                    <img
                        src={fotoPiloto.imagen}
                        alt={`Imagen de ${driver.name}`}
                        loading="eager"
                        decoding="async"
                    />


                    <!-- =====================================
                         DERECHOS DE AUTOR
                         ALINEADOS A LA DERECHA
                         ===================================== -->

                    {
                        tieneCreditos && (

                            <figcaption class="credito-fotografia">

                                {
                                    fotoPiloto.credito && (

                                        <div class="credito-linea">
                                            {fotoPiloto.credito}
                                        </div>

                                    )
                                }

                                {
                                    (
                                        fotoPiloto.adaptacion ||
                                        fotoPiloto.licencia ||
                                        fotoPiloto.original
                                    ) && (

                                        <div class="credito-linea">

                                            {
                                                fotoPiloto.adaptacion && (
                                                    <span>
                                                        {fotoPiloto.adaptacion}
                                                    </span>
                                                )
                                            }

                                            {
                                                fotoPiloto.licencia && (
                                                    <>
                                                        {
                                                            fotoPiloto.adaptacion
                                                                ? " · "
                                                                : ""
                                                        }

                                                        <a
                                                            href={fotoPiloto.licencia}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                        >
                                                            CC BY-SA 4.0
                                                        </a>
                                                    </>
                                                )
                                            }

                                            {
                                                fotoPiloto.original && (
                                                    <>
                                                        {
                                                            (
                                                                fotoPiloto.adaptacion ||
                                                                fotoPiloto.licencia
                                                            )
                                                                ? " · "
                                                                : ""
                                                        }

                                                        <a
                                                            href={fotoPiloto.original}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                        >
                                                            Fotografía original
                                                        </a>
                                                    </>
                                                )
                                            }

                                        </div>

                                    )
                                }

                            </figcaption>

                        )
                    }

                </figure>

            )
        }


        <!-- =====================================
             PERFIL DEL PILOTO
             ===================================== -->

        <header class="hero-p">

            <span class="label">
                PILOTO · #{driver.number}
            </span>

            <h1>
                {driver.name}
            </h1>

            {
                standing && (

                    <p class="stat">

                        P{standing.position}

                        {" · "}

                        {standing.points} puntos

                        {" · "}

                        <a
                            href={`/equipo/${slugifyTeam(
                                standing.team
                            )}/`}
                        >
                            {standing.team}
                        </a>

                    </p>

                )
            }

        </header>


        <!-- =====================================
             NOTICIAS DEL PILOTO
             ===================================== -->

        <section class="related-section">

            <h2>
                Noticias relacionadas
            </h2>

            {
                related.length > 0 ? (

                    <div class="news-grid">

                        {
                            related.map((article) => (

                                <a
                                    class="news-card"
                                    href={`/noticias/${article.data.slug}/`}
                                >
                                    {article.data.image && (
                                        <img
                                            src={article.data.image}
                                            alt={article.data.imageAlt || article.data.title}
                                            class="related-news-image"
                                            loading="lazy"
                                        />
                                    )}


                                    <time
                                        datetime={
                                            article.data.publishedAt.toISOString()
                                        }
                                    >
                                        {
                                            formatDate(
                                                article.data.publishedAt
                                            )
                                        }
                                    </time>

                                    <h3>
                                        {article.data.title}
                                    </h3>

                                </a>

                            ))
                        }

                    </div>

                ) : (

                    <p class="empty-message">
                        Las noticias etiquetadas con{" "}
                        {driver.name} aparecerán aquí.
                    </p>

                )
            }

        </section>

    </main>


    <Footer />

</body>

</html>


<style>

    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        background: #ffffff;
    }

    :global(body) {
        margin: 0;
        background: #ffffff;
        color: #111111;
        font-family: "Inter", sans-serif;
    }


    /* =========================
       CONTENEDOR
       ========================= */

    .profile {
        width: 100%;
        max-width: 1100px;
        margin: 45px auto 90px;
        padding: 0 20px;
    }


    /* =========================
       FOTOGRAFÍAS DE TODOS LOS PILOTOS
       ========================= */

    .driver-photo {
        width: 100%;
        max-width: 850px;
        margin: 0 auto 28px;
    }

    .driver-photo img {
        display: block;

        width: 100%;
        height: auto;

        max-width: 100%;
        max-height: none;

        object-fit: contain;
        object-position: center;

        background: #f1f1f1;
    }


    /* =========================
       DERECHOS DE AUTOR
       TODOS LOS PILOTOS
       ALINEACIÓN FORZADA A LA DERECHA
       ========================= */

    .credito-fotografia {
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-end !important;

        width: 100% !important;
        max-width: 100% !important;

        margin: 6px 0 0 !important;
        padding: 0 !important;

        font-family: Arial, sans-serif !important;
        font-size: 9px !important;
        font-weight: 400 !important;
        line-height: 1.5 !important;

        color: #888888 !important;
        text-align: right !important;
        letter-spacing: 0 !important;
    }

    .credito-linea {
        display: block !important;

        width: fit-content;
        max-width: 100%;

        margin: 0 0 0 auto !important;
        padding: 0 !important;

        font-family: Arial, sans-serif !important;
        font-size: 9px !important;
        font-weight: 400 !important;
        line-height: 1.5 !important;

        color: #888888 !important;
        text-align: right !important;
    }

    .credito-fotografia a {
        color: #777777 !important;

        font-size: inherit !important;
        font-weight: inherit !important;

        text-decoration: underline !important;
        text-underline-offset: 2px;
    }

    .credito-fotografia a:hover {
        color: #e10600 !important;
    }


    /* =========================
       PILOTO
       ========================= */

    .hero-p {
        padding: 25px 0 30px;
        border-bottom: 2px solid #e10600;
    }

    .label {
        display: block;
        color: #e10600;
        font-size: 0.8rem;
        font-weight: 900;
        text-align: center;
    }

    .hero-p h1 {
        margin: 8px 0;
        color: #111111;

        font-family: "Orbitron", sans-serif;

        font-size: clamp(
            2.4rem,
            8vw,
            5rem
        );

        font-weight: 900;
        line-height: 1;

        text-align: center;
        text-transform: uppercase;
    }

    .stat {
        margin: 18px 0 0;
        color: #bbbbbb;

        font-size: 1.1rem;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .stat a {
        color: inherit;
        font-weight: 700;
    }


    /* =========================
       NOTICIAS RELACIONADAS
