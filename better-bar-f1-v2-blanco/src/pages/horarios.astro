<body>


<MenuNav />


<main class="f1-schedule-page">


    <!-- =====================================================
         PANEL SUPERIOR
    ====================================================== -->


    <section class="f1-next-panel">


        <span class="f1-next-badge">

            Próximo Gran Premio

        </span>


        <h1
            id="f1-next-name"
            class="f1-next-title"
        >

            GP DE {initialNextRace?.gp}

        </h1>


        <p
            id="f1-next-circuit"
            class="f1-next-circuit"
        >

            {initialNextRace?.circuit}

        </p>


        <time
            id="f1-next-date"
            class="f1-next-date"
        >

            {initialNextRace?.raceDate}

        </time>



        <!--
            JavaScript genera aquí
            FP1, FP2, FP3, QUALY, SPRINT, CARRERA...
        -->

        <div id="f1-session-grid"></div>



        <div class="f1-timezone-bar">


            <span class="f1-timezone-text">

                Horarios en:

                <strong id="f1-timezone-name">

                    detectando…

                </strong>

            </span>



            <select
                id="f1-timezone-select"
                aria-label="Zona horaria"
            >


                <option value="">

                    Mi hora local

                </option>


                <option value="America/Mexico_City">

                    México

                </option>


                <option value="America/Monterrey">

                    Monterrey

                </option>


                <option value="America/Bogota">

                    Colombia

                </option>


                <option value="America/Argentina/Buenos_Aires">

                    Argentina

                </option>


                <option value="America/New_York">

                    Nueva York

                </option>


                <option value="Europe/Madrid">

                    España

                </option>


                <option value="Europe/London">

                    Reino Unido

                </option>


            </select>


        </div>


    </section>



    <!-- =====================================================
         CALENDARIO
    ====================================================== -->


    <section class="f1-calendar-section">


        <header class="f1-calendar-header">


            <span class="f1-calendar-kicker">

                Fórmula 1 · 2026

            </span>


            <h2 class="f1-calendar-title">

                Calendario completo

            </h2>


            <p class="f1-calendar-description">

                Calendario oficial de Grandes Premios

            </p>


        </header>



        <!--
            SIN DESPLEGABLES.

            JavaScript marcará automáticamente
            UNA SOLA carrera como próximo GP.
        -->


        <div id="f1-race-list">


            {
                races.map((race) => (

                    <article
                        class="f1-race-row"
                        data-round={race.round}
                    >


                        <span class="f1-race-round">

                            R{race.round}

                        </span>


                        <span class="f1-race-name">

                            GP DE {race.gp}

                        </span>


                        <span class="f1-race-circuit">

                            {race.circuit}

                        </span>


                    </article>

                ))
            }


        </div>


    </section>


</main>


<Footer />



<!-- =========================================================
     DATOS
========================================================== -->


<script
    id="f1-json"
    type="application/json"
    set:html={JSON.stringify(races)}
></script>



<script is:inline>


    /* =====================================================
       DATOS
    ===================================================== */


    const races =
        JSON.parse(
            document
                .getElementById("f1-json")
                .textContent || "[]"
        );



    /* =====================================================
       ZONA HORARIA DEL VISITANTE
    ===================================================== */


    const detectedTimezone =
        Intl
            .DateTimeFormat()
            .resolvedOptions()
            .timeZone
        ||
        "UTC";


    let activeTimezone =
        detectedTimezone;


    const timezoneName =
        document.getElementById(
            "f1-timezone-name"
        );


    const timezoneSelect =
        document.getElementById(
            "f1-timezone-select"
        );



    /* =====================================================
       DETECTAR PRÓXIMO GP
    ===================================================== */


    function getNextRace() {


        const now =
            Date.now();


        return (

            races.find(
                (race) =>

                    new Date(
                        race.raceEndUTC
                    ).getTime() >= now
            )

            ||

            races[
                races.length - 1
            ]

        );

    }



    /* =====================================================
       FECHA DEL GRAN PREMIO
    ===================================================== */


    function formatRaceDate(
        raceDate,
        timezone
    ) {


        if (!raceDate) {

            return "";

        }


        const date =
            new Date(
                `${raceDate}T12:00:00Z`
            );


        return new Intl.DateTimeFormat(
            "es-MX",
            {

                weekday:
                    "long",

                day:
                    "numeric",

                month:
                    "long",

                year:
                    "numeric",

                timeZone:
                    timezone

            }
        )
        .format(date)
        .toUpperCase();

    }



    /* =====================================================
       DÍA DE LA SESIÓN
    ===================================================== */


    function formatSessionDate(
        utc,
        timezone
    ) {


        return new Intl.DateTimeFormat(
            "es-MX",
            {

                weekday:
                    "short",

                day:
                    "2-digit",

                month:
                    "short",

                timeZone:
                    timezone

            }
        )
        .format(
            new Date(utc)
        );

    }



    /* =====================================================
       HORA DE LA SESIÓN
    ===================================================== */


    function formatSessionHour(
        utc,
        timezone
    ) {


        return new Intl.DateTimeFormat(
            "es-MX",
            {

                hour:
                    "2-digit",

                minute:
                    "2-digit",

                timeZone:
                    timezone,

                timeZoneName:
                    "short"

            }
        )
        .format(
            new Date(utc)
        );

    }



    /* =====================================================
       PANEL DEL PRÓXIMO GP
    ===================================================== */


    function renderNextPanel() {


        const race =
            getNextRace();


        if (!race) {

            return;

        }



        document
            .getElementById(
                "f1-next-name"
            )
            .textContent =
                `GP DE ${race.gp.toUpperCase()}`;



        document
            .getElementById(
                "f1-next-circuit"
            )
            .textContent =
                race.circuit;



        document
            .getElementById(
                "f1-next-date"
            )
            .textContent =
                formatRaceDate(
                    race.raceDate,
                    activeTimezone
                );



        const grid =
            document.getElementById(
                "f1-session-grid"
            );


        grid.replaceChildren();



        race.sessions.forEach(
            (session) => {


                const card =
                    document.createElement(
                        "article"
                    );


                card.className =
                    "f1-session-card";



                if (
                    session.name
                        .toUpperCase() ===
                    "CARRERA"
                ) {

                    card.classList.add(
                        "f1-race-session"
                    );

                }



                const label =
                    document.createElement(
                        "span"
                    );


                label.className =
                    "f1-session-label";


                label.textContent =
                    session.name;



                const date =
                    document.createElement(
                        "span"
                    );


                date.className =
                    "f1-session-date";


                date.textContent =
                    formatSessionDate(
                        session.utc,
                        activeTimezone
                    );



                const hour =
                    document.createElement(
                        "span"
                    );


                hour.className =
                    "f1-session-hour";


                hour.textContent =
                    formatSessionHour(
                        session.utc,
                        activeTimezone
                    );



                card.append(
                    label,
                    date,
                    hour
                );


                grid.appendChild(
                    card
                );

            }
        );

    }



    /* =====================================================
       RESALTAR SOLO EL PRÓXIMO GP
    ===================================================== */


    function renderCalendarHighlight() {


        const race =
            getNextRace();



        /*
         * Eliminamos cualquier etiqueta anterior.
         * Siempre habrá una sola.
         */


        document
            .querySelectorAll(
                ".f1-only-next-label"
            )
            .forEach(
                (element) =>
                    element.remove()
            );



        document
            .querySelectorAll(
                "#f1-race-list .f1-race-row"
            )
            .forEach(
                (row) => {


                    row.classList.remove(
                        "f1-current-race"
                    );



                    const round =
                        Number(
                            row.dataset.round
                        );



                    const isNext =
                        round ===
                        Number(
                            race.round
                        );



                    if (!isNext) {

                        return;

                    }



                    row.classList.add(
                        "f1-current-race"
                    );



                    const raceName =
                        row.querySelector(
                            ".f1-race-name"
                        );



                    const badge =
                        document.createElement(
                            "span"
                        );


                    badge.className =
                        "f1-only-next-label";


                    badge.textContent =
                        "PRÓXIMO";


                    raceName.appendChild(
                        badge
                    );


                }
            );

    }



    /* =====================================================
       RENDER GENERAL
    ===================================================== */


    function renderAll() {


        timezoneName.textContent =
            activeTimezone;


        renderNextPanel();


        renderCalendarHighlight();

    }



    /* =====================================================
       CAMBIO DE ZONA HORARIA
    ===================================================== */


    timezoneSelect
        .addEventListener(
            "change",
            () => {


                activeTimezone =
                    timezoneSelect.value
                    ||
                    detectedTimezone;


                renderAll();

            }
        );



    /* =====================================================
       INICIO
    ===================================================== */


    renderAll();


</script>


</body>

</html>