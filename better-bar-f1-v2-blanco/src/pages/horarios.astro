---
import MenuNav from "../components/MenuNav.astro";
import Footer from "../components/Footer.astro";
import races from "../data/f1-data.json";

const now = new Date();

const initialNextRace =
    races.find(
        (race) =>
            new Date(race.raceEndUTC).getTime() >= now.getTime()
    ) ?? races[races.length - 1];
---

<!doctype html>
<html lang="es">

<head>
    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    />

    <title>Horarios F1 2026 | Dagger Racing News</title>

    <link
        rel="stylesheet"
        href="/css/styless.css"
    />

    <style is:global>

        :root {
            --f1-red: #e10600;
            --f1-red-dark: #b80000;
