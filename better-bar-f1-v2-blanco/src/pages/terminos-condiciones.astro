<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Términos y Condiciones de Uso - Dagger Racing News</title>
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="icon" type="image/png" href="/daggerracingnews-logotipo.png" />
</head>
<body>

    <!-- MENÚ ACTUALIZADO IGUAL AL INDEX -->
    <header>
        <div class="logo-area" style="display: flex !important; align-items: center !important; flex-direction: row !important;">
            <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none; white-space: nowrap;">
                <img src="/drn-logo.PNG" alt="Logo" style="height: 30px; width: auto; display: block;" />
                <span style="font-weight: 800; font-size: 0.7rem; color: #ffffff; font-family: sans-serif; text-transform: uppercase;">
