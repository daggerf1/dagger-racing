<style>
    body {
        font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #fcfcfd;
        color: #334155;
        -webkit-font-smoothing: antialiased;
    }

    /* Estilos del menú alineados con global.css */
    header {
        background: #09090b;
        border-bottom: 3px solid #e10600;
        padding: 10px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    header nav a {
        color: #a1a1aa;
        text-decoration: none;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-left: 15px;
        transition: color 0.2s ease;
    }
    
    header nav a:hover {
        color: #ffffff;
    }

    .legal-container {
        max-width: 740px;
        margin: 50px auto;
        padding: 0 20px;
    }

    .legal-container h2 {
        font-size: 22px;
        font-weight: 700;
        color: #09090b;
        border-left: 3px solid #e10600;
        padding-left: 12px;
        margin-bottom: 4px;
        letter-spacing: 0.5px;
    }

    .last-update {
        font-size: 11px;
        color: #71717a;
        text-transform: uppercase;
        margin: 0 0 20px 0;
        padding-left: 15px;
    }

    .legal-content {
        font-size: 15px;
        line-height: 1.75;
        color: #27272a;
    }

    .legal-content h3 {
        font-size: 16px;
        font-weight: 600;
        color: #09090b;
        margin-top: 30px;
        margin-bottom: 8px;
    }
    
    .legal-content strong {
        color: #09090b;
    }
</style>