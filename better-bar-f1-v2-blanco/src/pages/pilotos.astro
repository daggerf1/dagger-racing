    height: 2px;
    background: #ff0000;
}

@media (max-width: 760px) {

    .drn-identity-banner img {
        width: 100%;
        height: auto;
    }

    .drn-identity-route {
        margin-top: 14px;
        padding: 0 12px;
        font-size: 9px;
    }

    body.drn-paddock-campeonato
    .drn-world .dw-header::after {
        right: 2%;
        width: 5px;
        opacity: .45;
        box-shadow: 9px 0 0 #a90000;
    }

    .drn-identity-signature {
        font-size: 9px;
        gap: 8px;
    }
}

/* DRN-RACING-IDENTITY-FIN */


/* DRN-BANNER-AJUSTE-INICIO */

body .drn-identity-banner {
    width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
    background: #090a0c !important;
    border-bottom: 0 !important;
    line-height: 0 !important;
}

body .drn-identity-banner a {
    display: block !important;
    width: 100% !important;
    max-width: 1600px !important;
    margin: 0 auto !important;
    padding: 0 !important;
}

body .drn-identity-banner img {
    display: block !important;
    width: 100% !important;
    max-width: 1600px !important;
    height: auto !important;
    aspect-ratio: 8 / 1;
    object-fit: contain !important;
    margin: 0 auto !important;
    padding: 0 !important;
}

/* DRN-BANNER-AJUSTE-FIN */
</style>
