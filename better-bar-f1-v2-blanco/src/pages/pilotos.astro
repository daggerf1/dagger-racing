
---
import MenuNav from "../components/MenuNav.astro";
import Footer from "../components/Footer.astro";

import drivers from "../data/editorial/drivers.json";

const activeDrivers = drivers.filter(
    (driver) => driver.active
);

/*
====================================================
    FOTOS DE LOS PILOTOS — DAGGER RACING NEWS
====================================================

INSTRUCCIONES:

1. Guarda cada imagen dentro de la carpeta public.

2. Busca aquí el nombre del piloto.

3. Escribe el nombre de la imagen entre las comillas.

EJEMPLO:

"charles-leclerc": "/mi-foto-de-charles.png",

Si dejas las comillas vacías "", la tarjeta
seguirá siendo blanca hasta que tengas su foto.

Para cambiar una imagen en el futuro,
solo cambia el nombre del archivo aquí.

NO HACE FALTA TOCAR EL RESTO DEL CÓDIGO.
====================================================
*/

const fotosPilotos: Record<string, string> = {

    // ============================================
    // MERCEDES
    // ============================================

    // AQUÍ KIMI ANTONELLI — FOTO COLOCADA
    "kimi-antonelli":
        "/monoplaza_antonelli_drn_daggerracingnews.png",

    // AQUÍ GEORGE RUSSELL
    "george-russell": "/monoplaza_russell_drn_daggerracingnews.png",


    // ============================================
    // FERRARI
    // ============================================

    // AQUÍ CHARLES LECLERC
    "charles-leclerc": "/monoplaza_leclerc_drn_daggerracingnews.png",

    // AQUÍ LEWIS HAMILTON
    "lewis-hamilton": "/monoplaza_hamilton_drn_daggerracingnews.png",


    // ============================================
    // RED BULL
    // ============================================

    // AQUÍ MAX VERSTAPPEN
    "max-verstappen": "/monoplaza_verstappen_drn_daggerracingnews.png",

    // AQUÍ ISACK HADJAR
    "isack-hadjar": "/monoplaza_hadjar_drn_daggerracingnews.png",


    // ============================================
    // MCLAREN
    // ============================================

    // AQUÍ LANDO NORRIS
    "lando-norris": "/monoplaza_norris_drn_daggerracingnews.png",

    // AQUÍ OSCAR PIASTRI
    "oscar-piastri": "/monoplaza_piastri_drn_daggerracingnews.png",


    // ============================================
    // ASTON MARTIN
    // ============================================

    // AQUÍ FERNANDO ALONSO
    "fernando-alonso": "/monoplaza_alonso_drn_daggerracingnews.png",

    // AQUÍ LANCE STROLL
    "lance-stroll": "/monoplaza_stroll_drn_daggerracingnews.png",


    // ============================================
    // ALPINE
    // ============================================

    // AQUÍ PIERRE GASLY
    "pierre-gasly": "/monoplaza_gasly_drn_daggerracingnews.png",

    // AQUÍ FRANCO COLAPINTO
    "franco-colapinto": "/monoplaza_colapinto_drn_daggerracingnews.png",


    // ============================================
    // HAAS
    // ============================================

    // AQUÍ RAFAEL CAMARA
    "rafael-camara": "/monoplaza_camara_drn_daggerracingnews.png",

    // AQUÍ OLIVER BEARMAN
    "oliver-bearman": "/monoplaza_bearman_drn_daggerracingnews.png",


    // ============================================
    // RACING BULLS
    // ============================================

    // AQUÍ LIAM LAWSON
    "liam-lawson": "/monoplaza_lawson_drn_daggerracingnews.png",

    // AQUÍ ARVID LINDBLAD
    "arvid-lindblad": "/monoplaza_lindblad_drn_daggerracingnews.png",


    // ============================================
    // WILLIAMS
    // ============================================

    // AQUÍ CARLOS SAINZ
    "carlos-sainz": "/monoplaza_sainz_drn_daggerracingnews.png",

    // AQUÍ ALEX ALBON
    "alexander-albon": "/monoplaza_albon_drn_daggerracingnews.png",


    // ============================================
    // AUDI
    // ============================================

    // AQUÍ NICO HÜLKENBERG
    "nico-hulkenberg": "/monoplaza_hulkenberg_drn_daggerracingnews.png",

    // AQUÍ GABRIEL BORTOLETO
    "gabriel-bortoleto": "/monoplaza_bortoleto_drn_daggerracingnews.png",


    // ============================================
    // CADILLAC
    // ============================================

    // AQUÍ SERGIO PÉREZ
    "sergio-perez": "/monoplaza_perez_drn_daggerracingnews.png",

    // AQUÍ VALTTERI BOTTAS
    "valtteri-bottas": "/monoplaza_bottas_drn_daggerracingnews.png"

};

/*
    BUSCAR LA FOTO DE CADA PILOTO

    Las claves de arriba deben coincidir
    con el slug de drivers.json.

    Para Kimi también comprobamos el nombre,
    por si su slug fuera diferente.
*/

function obtenerFoto(driver: (typeof drivers)[number]): string {

    const slug = driver.slug.toLowerCase();
    const nombre = driver.name.toLowerCase();

    if (nombre.includes("antonelli")) {
        return fotosPilotos["kimi-antonelli"];
    }

    return fotosPilotos[slug] || "";
}
---

<!doctype html>
<html lang="es">

<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6167283917185567" crossorigin="anonymous"></script>
    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>Pilotos F1 | Dagger Racing News</title>

    <meta
        name="description"
        content="Todos los pilotos de Fórmula 1 en Dagger Racing News."
    />

    <link
        rel="stylesheet"
        href="/css/styless.css"
    />

    <link
        rel="icon"
        type="image/png"
        href="/daggerracingnews-logotipo.png"
    />

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    />

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />

    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    />
<link rel="stylesheet" href="/css/drn-paddock-premium.css" />

    <!-- DRN-NIGHT-RACING -->
    <link rel="stylesheet" href="/css/drn-night-racing.css" />
</head>

<body class="drn-paddock drn-paddock-pilotos">

    <MenuNav />

<!-- DRN-IDENTITY-INICIO -->

<div class="drn-identity-banner">
    <a href="/" aria-label="Dagger Racing News - Inicio">
        <img
            src="/encabezado-dagger-web-1600x200.webp"
            alt="Dagger Racing News"
            decoding="async"
        />
    </a>
</div>

<div class="drn-identity-route">
    <span><a href="/">INICIO</a> / PILOTOS</span>
    <strong>FÓRMULA 1 · 2026</strong>
</div>

<!-- DRN-IDENTITY-FIN -->



    <main class="drivers-page">

        <!-- CABECERA -->

        <header class="drivers-header">

            <span class="eyebrow">
                FÓRMULA 1
            </span>

            <h1>
                PILOTOS
            </h1>

            <p style="display: block !important; width: 100% !important; max-width: none !important; margin-left: auto !important; margin-right: auto !important; text-align: center !important; text-align-last: center !important;">
                Consulta los perfiles de los pilotos y
                todas las noticias relacionadas con cada uno.
            </p>

        </header>

        <!-- CUADRÍCULA DE PILOTOS -->

        <section
            class="drivers-grid"
            aria-label="Pilotos de Fórmula 1"
        >

            {
                activeDrivers.map((driver) => {

                    const foto = obtenerFoto(driver);
                    const tieneFoto = foto.length > 0;

                    return (

                        <a
                            class:list={[
                                "driver-card",
                                {
                                    "driver-card--con-foto": tieneFoto
                                }
                            ]}
                            href={`/piloto/${driver.slug}/`}
                            style={
                                tieneFoto
                                    ? {
                                        "--foto-piloto": `url("${foto}")`
                                    }
                                    : undefined
                            }
                        >

                            <div class="driver-number">
                                #{driver.number}
                            </div>

                            <div class="driver-info">

                                <span class="driver-label">
                                    PILOTO
                                </span>

                                <h2>
                                    {driver.name}
                                </h2>

                                <span class="driver-link">
                                    VER PERFIL

                                    <span aria-hidden="true">
                                        →
                                    </span>
                                </span>

                            </div>

                        </a>

                    );
                })
            }

        </section>

    </main>

    

<!-- DRN-SIGNATURE-INICIO -->

<div class="drn-identity-signature">
    DAGGER RACING NEWS
</div>

<!-- DRN-SIGNATURE-FIN -->

<Footer />

</body>
</html>

<style>

    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        background: #ffffff;
    }

    :global(body) {
        margin: 0;
        background: #ffffff;
        color: #111111;
        font-family: "Inter", sans-serif;
    }

    /* =========================
       PÁGINA
       ========================= */

    .drivers-page {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        padding: 60px 30px 90px;
    }

    /* =========================
       CABECERA
       ========================= */

    .drivers-header {
        position: relative;
        margin-bottom: 42px;
        padding-bottom: 28px;
        border-bottom: 1px solid #dddddd;
    }

    .drivers-header::after {
        content: "";
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 90px;
        height: 3px;
        background: #e10600;
    }

    .eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #e10600;
        font-family: "Orbitron", sans-serif;
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 2px;
    }

    .drivers-header h1 {
        margin: 0;
        color: #111111;
        font-family: "Orbitron", sans-serif;
        font-size: clamp(2.8rem, 8vw, 5.5rem);
        font-weight: 900;
        line-height: 1;
        letter-spacing: -2px;
    }

    .drivers-header p {
        max-width: 650px;
        margin: 18px 0 0;
        color: #666666;
        font-size: 1rem;
        line-height: 1.6;
    }

    /* =========================
       GRID
       ========================= */

    .drivers-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    /* =========================
       TARJETA NORMAL — SIN FOTO
       ========================= */

    .driver-card {
        position: relative;
        min-height: 190px;
        padding: 24px;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        overflow: hidden;

        background: #ffffff;

        border: 1px solid #dddddd;
        border-top: 4px solid #111111;

        color: #111111;
        text-decoration: none;

        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .driver-card:hover {
        transform: translateY(-4px);
        border-color: #e10600;
        border-top-color: #e10600;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    /* =========================
       TARJETA CON FOTO

       ESTE ESTILO SE APLICA
       AUTOMÁTICAMENTE CUANDO
       AÑADAS UNA FOTO ARRIBA.
       ========================= */

    .driver-card--con-foto {
        background-image:
            linear-gradient(
                to top,
                rgba(0, 0, 0, 0.88) 0%,
                rgba(0, 0, 0, 0.15) 85%
            ),
            var(--foto-piloto);

        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .driver-card--con-foto .driver-info h2 {
        color: #ffffff;
    }

    .driver-card--con-foto .driver-label {
        color: #ff5555;
    }

    .driver-card--con-foto .driver-link {
        color: #ffffff;
    }

    .driver-card--con-foto .driver-number {
        color: rgba(255, 255, 255, 0.75);
    }

    .driver-card--con-foto:hover .driver-link {
        color: #ffffff;
    }

    .driver-card--con-foto:hover .driver-number {
        color: #ffffff;
    }

    /* =========================
       NÚMERO
       ========================= */

    .driver-number {
        position: absolute;
        top: 8px;
        right: 15px;

        color: #eeeeee;

        font-family: "Orbitron", sans-serif;
        font-size: 3.7rem;
        font-weight: 900;
        line-height: 1;

        transition: color 0.2s ease;
    }

    .driver-card:hover .driver-number {
        color: #ffe4e4;
    }

    /* =========================
       INFORMACIÓN
       ========================= */

    .driver-info {
        position: relative;
        z-index: 2;
        margin-top: auto;
    }

    .driver-label {
        display: block;
        margin-bottom: 7px;
        color: #e10600;
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 1.5px;
    }

    .driver-info h2 {
        max-width: 85%;
        margin: 0 0 18px;

        color: #111111;

        font-family: "Orbitron", sans-serif;
        font-size: 1.35rem;
        font-weight: 900;
        line-height: 1.15;
        text-transform: uppercase;
    }

    .driver-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        color: #555555;

        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 1px;

        transition: color 0.2s ease;
    }

    .driver-card:hover .driver-link {
        color: #e10600;
    }

    /* =========================
       TABLET
       ========================= */

    @media (max-width: 900px) {

        .drivers-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

    }

    /* =========================
       MÓVIL
       ========================= */

    @media (max-width: 600px) {

        .drivers-page {
            padding: 40px 16px 65px;
        }

        .drivers-header {
            margin-bottom: 28px;
        }

        .drivers-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .driver-card {
            min-height: 155px;
            padding: 20px;
        }

        .driver-number {
            font-size: 3rem;
        }

        .driver-info h2 {
            font-size: 1.2rem;
        }

    }

</style>


<style is:global>

/* DRN-RACING-IDENTITY-INICIO */

body.drn-paddock-campeonato,
body.drn-paddock-calendario,
body.drn-paddock-pilotos {
    background: #ffffff !important;
    background-image: none !important;
}

.drn-identity-banner {
    width: 100%;
    background: #090a0c;
    border-bottom: 3px solid #ff0000;
    overflow: hidden;
    line-height: 0;
}

.drn-identity-banner img {
    display: block;
    width: 100%;
    max-width: 1600px;
    height: auto;
    margin: 0 auto;
}

.drn-identity-route {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1040px;
    box-sizing: border-box;
    margin: 18px auto 0;
    padding: 0 20px;
    color: #555555;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .7px;
}

.drn-identity-route a {
    color: #555555 !important;
    text-decoration: none;
}

.drn-identity-route strong {
    color: #d00000;
}

body.drn-paddock-campeonato
.drn-world .dw-header {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #101114 !important;
    border-top: 3px solid #ff0000 !important;
    border-bottom: 3px solid #ff0000 !important;
}

body.drn-paddock-campeonato
.drn-world .dw-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(
        135deg,
        transparent 0,
        transparent 5px,
        rgba(255,255,255,.025) 5px,
        rgba(255,255,255,.025) 7px
    );
}

body.drn-paddock-campeonato
.drn-world .dw-header::after {
    content: "";
    position: absolute;
    right: 5%;
    top: -50%;
    width: 12px;
    height: 200%;
    transform: skewX(-35deg);
    background: #ff0000;
    box-shadow: 20px 0 0 #a90000;
    opacity: .85;
    z-index: -1;
    pointer-events: none;
}

body.drn-paddock-campeonato
.drn-world .dw-table-head,
body.drn-paddock-campeonato
.drn-world .dw-note {
    color: #555555 !important;
}

body.drn-paddock-calendario
.f1-calendar-section > h2 {
    color: #202020 !important;
    border-bottom: 2px solid #ff0000;
    padding-bottom: 12px;
}

body.drn-paddock-pilotos
main > h1,
body.drn-paddock-pilotos
main > h2 {
    color: #202020 !important;
    border-bottom: 2px solid #ff0000;
    padding-bottom: 12px;
}

.drn-identity-signature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    max-width: 1040px;
    margin: 35px auto;
    padding: 0 20px;
    box-sizing: border-box;
    color: #555555;
    font-size: 11px;
    font-weight: 900;
    font-style: italic;
    letter-spacing: 1px;
