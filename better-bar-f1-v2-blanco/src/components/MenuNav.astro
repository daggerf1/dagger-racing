    }

    header[data-drn-racing-nav] .drn-racing-link:hover::after,
    header[data-drn-racing-nav] .drn-racing-link:focus-visible::after {
        transform: scaleX(1);
    }

    @media (prefers-reduced-motion: reduce) {
        header[data-drn-racing-nav] .drn-racing-link,
