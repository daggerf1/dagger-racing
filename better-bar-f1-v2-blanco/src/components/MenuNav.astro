        border-radius: 3px;
        box-shadow: 0 0 8px #ff5555, 0 0 15px #ff7777;
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 220ms ease;
    }

    header[data-drn-racing-nav] .drn-racing-link:hover,
    header[data-drn-racing-nav] .drn-racing-link:focus-visible {
        transform: translateY(-3px);
