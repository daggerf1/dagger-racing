---
import MenuNav from "../components/MenuNav.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description?: string;
    publishedAt: Date;
    updatedAt?: Date;
    author?: string;
    category: string;
    subcategory?: string;
    image?: string;
    imageAlt?: string;
    drivers?: string[];
    teams?: string[];
    tags?: string[];
}

const {
    title,
    description,
    publishedAt,
    updatedAt,
    author = "redaccion",
    category,
    subcategory,
    image,
    imageAlt,
    drivers = [],
    teams = [],
    tags = [],
} = Astro.props;

const formatDate = (date: Date) =>
    new Intl.DateTimeFormat("es-MX", {
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(date);

const formatName = (value: string) =>
    value
        .split("-")
        .map(
            (word) =>
                word.charAt(0).toUpperCase() +
                word.slice(1)
        )
        .join(" ");

const imageSrc = image
    ? image.startsWith("/")
        ? image
        : `/images/${image}`
    : undefined;

const authorName =
    author === "redaccion"
        ? "Redacción Dagger Racing News"
        : formatName(author);

/*
 * El canonical solamente se genera cuando Astro.site
 * esté configurado en astro.config.
 */
const canonicalURL = Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : undefined;

// DRN-SEO-NEWS-2026
const seoBase = "https://www.daggerracingnews.com";
const seoURL = new URL(Astro.url.pathname, seoBase).href;
const seoImage = imageSrc
    ? new URL(imageSrc, seoBase).href
    : new URL("/daggerracingnews-logotipo.png", seoBase).href;

const seoDescription = description || title;
const seoAuthor = authorName;

const newsSchema = {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: title,
    description: seoDescription,
    image: [seoImage],
    datePublished: new Date(publishedAt).toISOString(),
    ...(updatedAt ? { dateModified: new Date(updatedAt).toISOString() } : {}),
    author: {
        "@type": "Organization",
        name: seoAuthor,
    },
    publisher: {
        "@type": "Organization",
        name: "Dagger Racing News",
        logo: {
            "@type": "ImageObject",
            url: new URL("/daggerracingnews-logotipo.png", seoBase).href,
        },
    },
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": seoURL,
    },
    inLanguage: "es-MX",
};

---

<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />

        <title>{title} | Dagger Racing News</title>

        {
            description && (
                <meta
                    name="description"
                    content={description}
                />
            )
        }

        {
            canonicalURL && (
                <link
                    rel="canonical"
                    href={canonicalURL}
                />
            )
        }

        <link
            rel="stylesheet"
            href="/css/styless.css"
        />

        <link
            rel="icon"
            type="image/png"
            href="/daggerracingnews-logotipo.png"
        />

        <link
            rel="preconnect"
            href="https://fonts.googleapis.com"
        />

        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        />

        <link
            href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Inter:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MWQZRP8XT1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MWQZRP8XT1');
    </script>


        <!-- DRN-SEO-NEWS-2026 -->
        <meta property="og:type" content="article" />
        <meta property="og:site_name" content="Dagger Racing News" />
        <meta property="og:locale" content="es_MX" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={seoDescription} />
        <meta property="og:url" content={seoURL} />
        <meta property="og:image" content={seoImage} />
        <meta property="og:image:alt" content={imageAlt || title} />
        <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={seoDescription} />
        <meta name="twitter:image" content={seoImage} />

        <script
            type="application/ld+json"
            set:html={JSON.stringify(newsSchema).replace(/</g, "\\u003c")}
        />

</head>

    <body>
        <MenuNav />

        <main class="article-page">
            <article class="article">

                <!-- CABECERA EDITORIAL -->
                <header class="article-header">

                    <div class="article-kicker">
                    <!-- DRN-BIANCA-LIFESTYLE -->
                    {imageSrc.includes("bianca-leclerc-charles-leclerc-alexandra-leclerc-ferrari.png") ? (
                        <>
                            <a href="/">INICIO</a>
                            <span>/</span>
                            <a href="/etiqueta/lifestyle/">LIFESTYLE</a>
                        </>
                    ) : (
                        <>

                    {title === "Ferrari toca fondo en Brasil: Leclerc califica el rendimiento como un desastre" ? (
                        <>
                            <a href="/">INICIO</a>
                            <span>/</span>
                            <a href="/equipo/ferrari/">FERRARI</a>
                        </>
                    ) : (
                        <>

                    {drivers.includes("lewis-hamilton") ? (
                        <>
                            <a href="/">INICIO</a>
                            <span>/</span>
                            <a href="/piloto/lewis-hamilton/">HAMILTON</a>
                        </>
                    ) : (
                        <>

                    {drivers.includes("rafael-camara") ? (
                        <>
                            <a href="/">INICIO</a>
                            <span>/</span>
                            <a href="/piloto/rafael-camara/">CÂMARA</a>
                        </>
                    ) : (
                        <>
                            

                        <a href={category === "formula-1" || (category === "lifestyle" && subcategory === "pilotos" && drivers.includes("charles-leclerc")) ? "/" : `/categoria/${category}/`}>
                            {category === "formula-1" || (category === "lifestyle" && subcategory === "pilotos" && drivers.includes("charles-leclerc")) ? "INICIO" : formatName(category)}
                        </a>

                        {
                            subcategory && (
                                <>
                                    <span>/</span>

                                    <a
                                        href={
                                            (category === "lifestyle" && subcategory === "pilotos" && drivers.includes("charles-leclerc"))
                                                ? "/piloto/charles-leclerc/"
                                                : (subcategory === "cronica" || (subcategory === "paddock" && drivers.includes("oscar-piastri")))
                                                ? subcategory === "paddock" && drivers.includes("oscar-piastri")
                                                    ? "/piloto/oscar-piastri/"
                                                    : teams.length > 0
                                                        ? `/equipo/${teams[0]}/`
                                                        : drivers.length > 0
                                                            ? `/piloto/${drivers[0]}/`
                                                            : "/"
                                                : `/subcategoria/${subcategory}/`
                                        }
                                    >
                                        {(category === "lifestyle" && subcategory === "pilotos" && drivers.includes("charles-leclerc"))
                                            ? "LECLERC"
                                            : (subcategory === "cronica" || (subcategory === "paddock" && drivers.includes("oscar-piastri")))
                                            ? subcategory === "paddock" && drivers.includes("oscar-piastri")
                                                ? "PIASTRI"
                                                : teams.length > 0
                                                    ? formatName(teams[0])
                                                    : drivers.length > 0
                                                        ? formatName(drivers[0])
                                                        : formatName(subcategory)
                                            : formatName(subcategory)}
                                    </a>
                                </>
                            )
                        }

                    
                        </>
                    )}
                
                        </>
                    )}
                
                        </>
                    )}
                
                        </>
                    )}
                </div>

                    <h1>{title}</h1>

                    {
                        description && (
                            <p class="article-description">
                                {description}
                            </p>
                        )
                    }

                    <div class="article-meta">

                        <span>
                            Por <strong>{authorName}</strong>
                        </span>

                        <span class="meta-separator">
                            •
                        </span>

                        <time datetime={publishedAt.toISOString()}>
                            {formatDate(publishedAt)}
                        </time>

                        {
                            updatedAt &&
                            updatedAt.getTime() !==
                                publishedAt.getTime() && (
                                <>
                                    <span class="meta-separator">
                                        •
                                    </span>

                                    <span>
                                        Actualizada{" "}
                                        <time
                                            datetime={updatedAt.toISOString()}
                                        >
                                            {formatDate(updatedAt)}
                                        </time>
                                    </span>
                                </>
                            )
                        }

                    </div>

                </header>

                <!-- IMAGEN PRINCIPAL -->
                {
                    imageSrc && (
                        <figure class="article-image">
                            <img
                                src={imageSrc}
                                alt={imageAlt || title}
                                loading="eager"
                            />
                            <!-- DRN-VERSTAPPEN-CREDITOS-PORTADA -->
                            {imageSrc.includes("verstappen-interlagos-noviembre-2026.png") && (
                                <figcaption class="drn-photo-credit">
                                    <strong>Fotografía de referencia:</strong>{" "}
                                    Steffen Prößdorf (Stepro) / Wikimedia Commons ·{" "}
                                    <a
                                        href="https://creativecommons.org/licenses/by-sa/4.0/"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        CC BY-SA 4.0
                                    </a>.
                                    <br />
                                    <strong>Imagen ilustrativa recreada mediante IA:</strong>{" "}
                                    Dagger Racing News (DRN).
                                    <br />
                                    <a
                                        href="https://commons.wikimedia.org/wiki/File:2024-08-25_Motorsport,_Formel_1,_Gro%C3%9Fer_Preis_der_Niederlande_2024_STP_3973_by_Stepro_(portrait_cropped).jpg"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Fotografía original de Max Verstappen
                                    </a>
                                </figcaption>
                            )}


                            <!-- DRN-CREDITOS-TRES-NOTAS-NOV2026 -->
                            {imageSrc.includes("retrato-hadjar-interlagos-noviembre-2026.png") && (
                                <figcaption class="drn-photo-credit">
                                    📸 <strong>Fotografía de referencia:</strong>{" "}
                                    Yu Chu Chin / Wikimedia Commons ·{" "}
                                    <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>.
                                    <br />
                                    <strong>Imagen ilustrativa recreada mediante IA:</strong>{" "}
                                    Dagger Racing News (DRN).
                                    <br />
                                    <a href="https://commons.wikimedia.org/wiki/File:Isack_Hadjar_at_the_Melbourne_Walk_during_the_2026_Australian_Grand_Prix_(028A8755).jpg" target="_blank" rel="noopener noreferrer">
                                        Fotografía original de Isack Hadjar
                                    </a>
                                </figcaption>
                            )}

                            {imageSrc.includes("retrato-lawson-interlagos-noviembre-2026.png") && (
                                <figcaption class="drn-photo-credit">
                                    📸 <strong>Fotografía de referencia:</strong>{" "}
                                    Yu Chu Chin / Wikimedia Commons ·{" "}
                                    <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>.
                                    <br />
                                    <strong>Imagen ilustrativa recreada mediante IA:</strong>{" "}
                                    Dagger Racing News (DRN).
                                    <br />
                                    <a href="https://commons.wikimedia.org/wiki/File:Liam_Lawson_at_the_Red_Bull_Fan_Zone_%E2%80%93_Crown_Riverwalk,_Melbourne_(028A7792)_(cropped).jpg" target="_blank" rel="noopener noreferrer">
                                        Fotografía original de Liam Lawson
                                    </a>
                                </figcaption>
                            )}

                            {imageSrc.includes("hamilton-y-leclerc-interlagos-noviembre-2026.png") && (
                                <figcaption class="drn-photo-credit">
                                    📸 <strong>Imagen ilustrativa generada mediante inteligencia artificial:</strong>{" "}
                                    Dagger Racing News (DRN).
                                    <br />
                                    <em>Recreación editorial de Lewis Hamilton y Charles Leclerc.</em>
                                </figcaption>
                            )}

                            {imageSrc.includes("norris-interlagos-2026.png") && (
                                <figcaption class="drn-photo-credit">
                                    Fotografía original: Steffen Prößdorf (Stepro) / Wikimedia Commons · CC BY-SA 4.0 · Edición gráfica mediante IA: Dagger Racing News. Imagen modificada respecto al original.{" "}
                                    Original:{" "}
                                    <a
                                        href="https://commons.wikimedia.org/wiki/Special:Redirect/file/2024-08-25_Motorsport,_Formel_1,_Großer_Preis_der_Niederlande_2024_STP_3968_by_Stepro_(Lando_Norris).jpg"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Wikimedia Commons
                                    </a>
                                    {" "}· Licencia:{" "}
                                    <a
                                        href="https://creativecommons.org/licenses/by-sa/4.0/"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        CC BY-SA 4.0
                                    </a>
                                </figcaption>
                            )}
                            {imageSrc.includes("retrato-piastri-interlagos-2026.png") && (
                                <figcaption class="drn-photo-credit">
                                    Fotografía original: Yu Chu Chin / Wikimedia Commons · CC BY-SA 4.0 · Edición gráfica mediante IA: Dagger Racing News. Imagen modificada respecto al original.{" "}
                                    Original:{" "}
                                    <a
                                        href="https://commons.wikimedia.org/wiki/File:Oscar_Piastri_at_the_Melbourne_Walk_during_the_2026_Australian_Grand_Prix_(028A8603).jpg"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Wikimedia Commons
                                    </a>
                                    {" "}· Licencia:{" "}
                                    <a
                                        href="https://creativecommons.org/licenses/by-sa/4.0/"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        CC BY-SA 4.0
                                    </a>
                                </figcaption>
                            )}
                        
                            {imageSrc.includes("rafael-camara-haas-interlagos-2026.png") && (
                                <figcaption class="drn-photo-credit">
                                    <strong>Créditos de imagen:</strong>{" "}
                                    Ilustración editorial generada mediante inteligencia artificial por Dagger Racing News (DRN).
                                    <br />
                                    <em>Imagen representativa. No corresponde a una fotografía real ni documenta una escena ocurrida.</em>
                                </figcaption>
                            )}

                            {imageSrc.includes("hamilton-ferrari-interlagos-2026.png") && (
                                <figcaption class="drn-photo-credit">
                                    📸 <strong>Créditos:</strong>{" "}
                                    Beto Issa/F1 GP São Paulo · Wikimedia Commons ·{" "}
                                    <a href="https://creativecommons.org/licenses/by/2.0/" target="_blank" rel="noopener noreferrer">
                                        CC BY 2.0
                                    </a>.
                                    <br />
                                    <strong>Imagen ilustrativa editada mediante IA:</strong>{" "}
                                    Dagger Racing News (DRN).
                                    <br />
                                    <a href="https://commons.wikimedia.org/wiki/File:Grande_Pr%C3%AAmio_S%C3%A3o_Paulo_de_F%C3%B3rmula_1_(52498120773).jpg" target="_blank" rel="noopener noreferrer">
                                        Fotografía original
                                    </a>
                                </figcaption>
                            )}

                            {imageSrc.includes("ferrari-leclerc-nota-interlagos-2026.png") && (
                                <figcaption class="drn-photo-credit">
                                    📸 <strong>Créditos:</strong>{" "}
                                    Jen Ross / Wikimedia Commons ·{" "}
                                    <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">
                                        CC BY 4.0
                                    </a>.
                                    <br />
                                    <strong>Edición y adaptación mediante IA:</strong>{" "}
                                    Dagger Racing News (DRN).
                                    <br />
                                    <a href="https://commons.wikimedia.org/wiki/File:FIA_F1_Imola_2025_No._16_Leclerc.jpg" target="_blank" rel="noopener noreferrer">
                                        Fotografía original
                                    </a>
                                </figcaption>
                            )}
</figure>
                    )
                }

                <!-- PILOTOS Y EQUIPOS -->
                {
                    (drivers.length > 0 ||
                        teams.length > 0) && (
                        <div class="article-entities">

                            {
                                drivers.map((driver) => (
                                    <a
                                        href={`/piloto/${driver}/`}
                                        class="entity-link"
                                    >
                                        {formatName(driver)}
                                    </a>
                                ))
                            }

                            {
                                teams.map((team) => (
                                    <a
                                        href={`/equipo/${team}/`}
                                        class="entity-link"
                                    >
                                        {formatName(team)}
                                    </a>
                                ))
                            }

                        </div>
                    )
                }

                <!-- CUERPO DE LA NOTICIA -->
                <div class="article-content">
                    <slot />
                </div>

                <!-- HASHTAGS -->
                {
                    tags.length > 0 && (
                        <footer class="article-footer">

                            <div class="article-tags">

                                {
                                    tags.map((tag) => (
                                        <a
                                            href={`/etiqueta/${tag}/`}
                                            class="tag"
                                        >
                                            #
                                            {formatName(tag).replaceAll(
                                                " ",
                                                ""
                                            )}
                                        </a>
                                    ))
                                }

                            </div>

                        </footer>
                    )
                }

                <!-- NOTICIAS RELACIONADAS -->
                <section
                    class="related-section"
                    aria-labelledby="related-title"
                >

                    <div class="section-heading">

                        <span></span>

                        <h2 id="related-title">
                            Noticias relacionadas
                        </h2>

                    </div>

                    <div class="related-content">
                        <slot name="related" />
                    </div>

                </section>

            </article>
        </main>

        <Footer />
    
/* DRN-CREDITOS-VERSTAPPEN-UNIFORMES-INICIO */
<style is:global>
  .article-page:has(img[src*="verstappen-interlagos-noviembre-2026.png"])
  .drn-photo-credit {
    font-size: 0.75rem !important;
    line-height: 1.5 !important;
    color: #777777 !important;
    font-weight: 400 !important;
    font-style: normal !important;
    text-align: left !important;
    margin-top: 8px !important;
  }

  .article-page:has(img[src*="verstappen-interlagos-noviembre-2026.png"])
  .drn-photo-credit a {
    color: inherit !important;
    font-size: inherit !important;
    text-decoration: underline !important;
    text-underline-offset: 2px;
  }
</style>
/* DRN-CREDITOS-VERSTAPPEN-UNIFORMES-FIN */

</body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        background: #ffffff;
    }

    :global(body) {
        margin: 0;
        background: #ffffff;
        color: #111111;
        font-family: "Inter", sans-serif;
        overflow-x: hidden;
    }

    /* =========================
       CONTENEDOR
       ========================= */

    .article-page {
        width: 100%;
        min-height: 100vh;

        padding: 52px 20px 80px;

        background: #ffffff;
    }

    .article {
        width: 100%;
        max-width: 980px;

        margin: 0 auto;
    }

    /* =========================
       CABECERA
       ========================= */

    .article-header {
        width: 100%;
        max-width: 850px;
        margin-bottom: 32px;
    }

    .article-kicker {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;

        gap: 9px;

        margin-bottom: 18px;

        font-family: "Orbitron", sans-serif;
        font-size: 0.72rem;
        font-weight: 800;

        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

    .article-kicker a {
        color: #d60000;
        text-decoration: none;
    }

    .article-kicker a:hover {
        text-decoration: underline;
    }

    .article-kicker span {
        color: #aaaaaa;
    }

    h1 {
        margin: 0;
        text-align: center;

        color: #111111;

        font-family: "Orbitron", sans-serif;

        font-size: clamp(
            2rem,
            5vw,
            4rem
        );

        font-weight: 900;
        line-height: 1.04;

        letter-spacing: -1.5px;
    }

    .article-description {
        max-width: 820px;

        margin: 22px 0 0;
        text-align: center;

        color: #555555;

        font-size: clamp(
            1.05rem,
            2vw,
            1.28rem
        );

        line-height: 1.6;
    }

    /* =========================
       FECHA / AUTOR
       ========================= */

    .article-meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        align-items: center;

        gap: 8px;

        margin-top: 24px;
        padding-top: 18px;

        border-top: 1px solid #e5e5e5;

        color: #666666;

        font-size: 0.88rem;
    }

    .article-meta strong {
        color: #111111;
    }

    .meta-separator {
        color: #d60000;
    }

    /* =========================
       IMAGEN
       ========================= */

    .article-image {
        width: 100%;

        margin: 0 0 28px;
    }


    /* DRN-CREDITOS-FOTOGRAFICOS */
    .drn-photo-credit {
        margin-top: 8px;
        font-size: 0.75rem;
        line-height: 1.5;
        color: #777777;
        text-align: left;
    }

    .drn-photo-credit a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .article-image img {
        display: block;

        width: 100%;
        max-height: 620px;

        object-fit: cover;

        border-radius: 4px;
    }

    /* =========================
       PILOTOS / EQUIPOS
       ========================= */

    .article-entities {
        display: flex;
        flex-wrap: wrap;

        gap: 8px;

        margin: 0 0 32px;
    }

    .entity-link {
        padding: 7px 12px;

        border: 1px solid #dddddd;
        border-radius: 999px;

        color: #333333;
        background: #ffffff;

        font-size: 0.78rem;
        font-weight: 700;

        text-decoration: none;

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease;
    }

    .entity-link:hover {
        color: #ffffff;

        background: #d60000;

        border-color: #d60000;
    }

    /* =========================
       CONTENIDO
       ========================= */

    .article-content {
        max-width: 780px;

        color: #242424;

        font-size: 1.08rem;
        line-height: 1.85;
    }

    .article-content :global(p) {
        margin: 0 0 1.5em;
    }

    .article-content :global(h2) {
        margin: 2em 0 0.7em;

        color: #111111;

        font-family: "Orbitron", sans-serif;

        font-size: clamp(
            1.4rem,
            3vw,
            2rem
        );

        line-height: 1.2;
    }

    .article-content :global(h3) {
        margin: 1.8em 0 0.7em;

        color: #111111;

        font-size: 1.3rem;
    }

