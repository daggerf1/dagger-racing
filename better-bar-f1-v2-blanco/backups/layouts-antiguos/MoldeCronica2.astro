---
import MenuNav from "../components/MenuNav.astro";
import Footer from "../components/Footer.astro";
const { frontmatter, url } = Astro.props;

// CARGA DINÁMICA APUNTANDO A LA CARPETA DE NOTICIAS
const notasCargadas = import.meta.glob('../pages/noticias/*.md', { eager: true });

// ORDENAMIENTO CRONOLÓGICO INVERSO
const todasLasCronicas = Object.values(notasCargadas).sort((a: any, b: any) => {
    const fechaA = new Date(a.frontmatter.fecha).getTime();
    const fechaB = new Date(b.frontmatter.fecha).getTime();
    return fechaB - fechaA;
});

// Filtramos para recomendados
const cronicasRecomendadas = (todasLasCronicas as any).filter((nota: any) => nota.url !== url);
---
<!DOCTYPE html>
<html lang="es" style="height: 100%; margin: 0; padding: 0;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dagger Racing News - {frontmatter.titulo}</title>
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="icon" type="image/png" href="/daggerracingnews-logotipo.png">

    <!-- FORZAMOS QUE LA BARRA SUPERIOR SEA BLANCA E IGNORE EL CSS VIEJO -->
    <style is:global>
        header {
            background-color: #ffffff !important;
            background: #ffffff !important;
            border-bottom: 3px solid #e10600 !important;
        }
        header a, header span {
            color: #000000 !important;
        }
        header a span {
            color: #e10600 !important;
        }
        nav {
            background-color: transparent !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            position: static !important;
        }
        nav a {
            color: #000000 !important;
        }
        nav a:hover {
            color: #e10600 !important;
            background-color: transparent !important;
        }
    </style>
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh; margin: 0; padding: 0; box-sizing: border-box; overflow-x: hidden; background-color: #ffffff;">

    <!-- BARRA SUPERIOR TOTALMENTE EXPANDIDA -->
    <MenuNav />

    <!-- CONTENEDOR ESTRUCTURAL CENTRALIZADO -->
    <div style="flex: 1; width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 20px; box-sizing: border-box;">
        
        <main style="display: flex; flex-direction: row; gap: 25px; align-items: flex-start; margin-top: 40px; margin-bottom: 40px; width: 100%;">
            
            <!-- COLUMNA IZQUIERDA: ARTÍCULO (70%) -->
            <section class="noticias" style="flex: 7; min-width: 0; display: flex; flex-direction: column; gap: 35px;">
                <article class="tarjeta-noticia" style="border-left: 4px solid #e10600; padding: 0 0 25px 15px; background: #fff; border-bottom: 2px solid #e2e8f0;">
                    
                    <div class="contenido-cabecera" style="margin-bottom: 15px;">
                        <span class="fecha" style="color: #e10600; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; display: block; margin-bottom: 8px;">{frontmatter.fechaEtiqueta}</span>
                        <h2 class="titular-cronica" style="font-size: 1.8rem; margin: 10px 0 20px 0; line-height: 1.3; font-family: 'Orbitron', sans-serif; color: #0f172a;">{frontmatter.titulo}</h2>
                    </div>

                    <div class="contenedor-imagen-live" style="height: 400px; margin-bottom: 20px; overflow: hidden; border-radius: 4px;">
                        <img src={`/${frontmatter.imagen}`} alt="Imagen de portada" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    
                     {frontmatter.credito && (
                        <div style="text-align: right; width: 100%; margin-top: 5px; margin-bottom: 15px;">
                            <span style="font-size: 11px; color: #b3b3b3; font-style: italic; font-family: Arial, sans-serif;">
                                Foto: {frontmatter.credito}
                            </span>
                        </div>
                    )}
                    
                    <!-- RELLENO INTERNO EN TEXTO PARA EVITAR AMONTONAMIENTO -->
                    <div class="contenido" style="padding: 10px 15px 0 0; box-sizing: border-box;">
                        <slot />

                        <button id="btn-desplegar-tabla" class="boton-desplegar" style="display: block; width: 100%; background-color: #15151e; color: white; border: none; padding: 12px; font-family: 'Orbitron', sans-serif; cursor: pointer; text-align: center; font-size: 0.9rem; margin-top: 30px; margin-bottom: 20px; font-weight: bold; text-transform: uppercase;">
                            Ver resto de posiciones ↓
                        </button>
                        
                        <br>
                        <a href="/" class="boton-leer" style="display: inline-block; background: #0f172a; color: #ffffff; padding: 12px 28px; text-decoration: none; font-family: 'Orbitron', sans-serif; font-weight: 700; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px;">VOLVER AL INICIO</a>
                    </div>
                </article>
            </section>

           <!-- COLUMNA DERECHA: RECOMENDADOS (30%) -->
            <aside class="barra-lateral-derecha" style="flex: 3; min-width: 300px; box-sizing: border-box;">
                <div style="position: sticky; top: 90px; display: flex; flex-direction: column; gap: 20px;">

                    <div class="seccion-proxima" style="background: #ffffff; padding: 15px; border-radius: 8px; border: 1px solid #e0e0e0; border-left: 4px solid #e10600;">
                        <h3 style="font-family: 'Orbitron', sans-serif; color: #111111; margin-top:0; font-size: 1.3rem; text-transform: uppercase;">Crónicas Anteriores</h3>
                        <div class="evento">
                            <p style="color: #222222; margin:0; font-size: 1.1rem;"><strong>Artículos recomendados</strong></p>
                            <p style="color: #666666; font-size: 0.85rem; margin:0;">No te pierdas las últimas novedades</p>
                        </div>
                    </div>

                    <div class="seccion-horarios" style="background: #ffffff; padding: 15px; border-radius: 8px; border: 1px solid #e0e0e0;">
                        <h4 style="font-family: 'Orbitron', sans-serif; color: #111111; margin-top:0; margin-bottom:15px; font-size: 1.3rem; text-transform: uppercase;">Más Noticias</h4>
                        <div class="tabla-horarios" style="display: flex; flex-direction: column; gap: 15px;">
                            {cronicasRecomendadas && cronicasRecomendadas.length > 0 ? (
                                cronicasRecomendadas.slice(0, 3).map((nota: any) => (
                                    <div class="fila-paises" style="background: #ffffff; border: 1px solid #eaeaea; border-radius: 6px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.05)'" onmouseout="this.style.transform='none'; this.style.boxShadow='none'">
                                        <div style="height: 110px; width: 100%;">
                                            <img src={`/${nota.frontmatter.imagen}`} alt={nota.frontmatter.titulo} style="width: 100%; height: 100%; object-fit: cover;">
                                        </div>
                                        <div style="padding: 10px;">
                                            <a href={nota.url} style="text-decoration: none; color: inherit; display: block;">
                                                <span style="font-size: 0.7rem; color: #e10600; font-weight: bold; display: block; margin-bottom: 4px; font-family: 'Orbitron', sans-serif;">
                                                    {nota.frontmatter.fechaEtiqueta}
                                                </span>
                                                <p class="carrera" style="font-size: 0.85rem; font-weight: bold; line-height: 1.3; color: #222222; margin: 0; font-family: 'Orbitron', sans-serif; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                    {nota.frontmatter.titulo}
                                                </p>
                                            </a>
                                        </div>
                                    </div>
                                ))
                            ) : (
                                <p style="font-size: 0.85rem; color: #666; font-family: sans-serif;">Cargando novedades del paddock...</p>
                            )}
                        </div>
                    </div>

                </div>
            </aside>
            
        </main>
    </div>

    <!-- BARRA INFERIOR UNIFICADA CON COOKIES Y ENLACES LEGALES (100% ANCHO) -->
    <footer style="background: #000000; text-align: center; padding: 25px 0; margin-top: auto; border-top: 1px solid #e2e8f0; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; box-sizing: border-box;">
        <div style="margin-bottom: 10px;">
            <a href="/politica-privacidad" style="color: #a1aab8; text-decoration: none; font-size: 11px; margin: 0 10px; font-family: sans-serif; font-weight: 600; transition: color 0.2s;">Política de Privacidad</a>
            <span style="color: #cbd5e1;">|</span>
            <a href="/terminos-condiciones" style="color: #a1aab8; text-decoration: none; font-size: 11px; margin: 0 10px; font-family: sans-serif; font-weight: 600; transition: color 0.2s;">Términos y Condiciones</a>
            <span style="color: #cbd5e1;">|</span>
            <a href="/politica-cookies" style="color: #a1aab8; text-decoration: none; font-size: 11px; margin: 0 10px; font-family: sans-serif; font-weight: 600; transition: color 0.2s;">Política de Cookies</a>
        </div>
        <p style="color: #dde0e4; font-size: 11px; margin: 0; font-family: sans-serif; font-weight: 500;">
            © 2026 Dagger Racing News. Todos los derechos reservados. 
        </p>
    </footer>

    <!-- INTERACTIVIDAD DE DESPLEGUE SANEADA (VERSIÓN UNIVERSAL ASTRO) -->
    <script is:inline>
        function iniciarTablaDesplegable() {
            const boton = document.getElementById("btn-desplegar-tabla");
            const tablaOculta = document.querySelector(".filas-tabla-ocultas");

            if (tablaOculta && boton) {
                tablaOculta.style.display = "none";
                boton.onclick = null; 
                
                boton.onclick = () => {
                    if (tablaOculta.style.display === "none") {
                        tablaOculta.style.display = "block";
                        boton.textContent = "Ocultar posiciones ↑";
                    } else {
                        tablaOculta.style.display = "none";
                        boton.textContent = "Ver resto de posiciones ↓";
                    }
                };
            } else {
                if (boton) boton.style.display = "none";
            }
        }

        iniciarTablaDesplegable();
        document.addEventListener("astro:page-load", iniciarTablaDesplegable);
    </script>

    <!-- ESTILOS LOCALES PARA SEPARAR PÁRRAFOS Y RESPONSIVO EN MÓVIL -->
    <style>
        .contenido :global(p) {
            margin-top: 0;
            margin-bottom: 22px !important;
            line-height: 1.65 !important;
            font-size: 1.05rem;
            color: #334155;
            font-family: sans-serif;
        }
        .contenido :global(h3) {
            margin-top: 35px !important;
            margin-bottom: 15px !important;
            font-family: 'Orbitron', sans-serif;
            color: #0f172a;
        }
        @media (max-width: 768px) {
            main {
                flex-direction: column !important;
            }
            .barra-lateral-derecha {
                width: 100% !important;
                margin-top: 20px;
            }
        }
    </style>

</body>
</html>