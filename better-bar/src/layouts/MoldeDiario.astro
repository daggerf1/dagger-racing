<style is:global>
  /* 1. CONTENEDOR PRINCIPAL (ESTILO DIARIO CLÁSICO) */
  .diario-cronica-container {
    display: grid;
    grid-template-columns: 2.2fr 1.3fr 2fr;
    gap: 32px;
    max-width: 1380px;
    margin: 30px auto;
    padding: 0 20px;
    font-family: 'Times New Roman', Times, serif;
    color: #111;
  }

  /* Forzamos a que el contenedor del slot use CSS Grid interno */
  .cuerpo-nota-1 {
    display: grid;
    grid-template-columns: 2.2fr 1.3fr 2fr;
    grid-column: 1 / -1; /* Rompe el bloque inicial y abarca todo el ancho */
    gap: 32px;
    width: 100%;
  }

  /* 2. DISEÑO DE LA CABECERA (Abarca las 3 columnas superiores) */
  .columna-principal-nota {
    grid-column: 1 / -1;
    width: 100%;
  }

  .columna-principal-nota h1 {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 2.8rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1px;
    margin: 12px 0 20px 0;
    text-align: center; /* Centrado clásico de cabecera de periódico */
  }

  .contenedor-imagen-boceto {
    border: 1px solid #111;
    padding: 5px;
    background: #fff;
    margin-bottom: 24px;
  }

  .contenedor-imagen-boceto img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 3. AUTOMATIZACIÓN DE COLUMNAS USANDO SELECTORES CSS */
  
  /* COLUMNA 1 (IZQUIERDA): Introducción + Plan Maestro */
  /* Envía los elementos iniciales a la columna 1 de la rejilla */
  .cuerpo-nota-1 > p:nth-of-type(1),
  .cuerpo-nota-1 > h2:nth-of-type(1),
  .cuerpo-nota-1 > p:nth-of-type(2),
  .cuerpo-nota-1 > p:nth-of-type(3) {
    grid-column: 1;
  }

  /* COLUMNA 2 (CENTRAL): El Quiebre (VSC) */
  /* Envía el segundo título h2 y sus párrafos al centro con las líneas divisorias de tu dibujo */
  .cuerpo-nota-1 > h2:nth-of-type(2),
  .cuerpo-nota-1 > p:nth-of-type(4),
  .cuerpo-nota-1 > p:nth-of-type(5),
  .cuerpo-nota-1 > p:nth-of-type(6) {
    grid-column: 2;
    border-left: 1px solid #111;
    border-right: 1px solid #111;
    padding: 0 20px;
  }

  /* COLUMNA 3 (DERECHA SUPERIOR): Drama en la pista */
  .cuerpo-nota-1 > h2:nth-of-type(3),
  .cuerpo-nota-1 > p:nth-of-type(7),
  .cuerpo-nota-1 > p:nth-of-type(8),
  .cuerpo-nota-1 > p:nth-of-type(9) {
    grid-column: 3;
  }

  /* SUB-BLOQUE INFERIOR DERECHO (Dividido en dos por la línea horizontal): Colapinto y Cierre */
  /* Estructuramos el área inferior derecha para simular tu fila dividida */
  .cuerpo-nota-1 > h2:nth-of-type(4),
  .cuerpo-nota-1 > p:nth-of-type(10),
  .cuerpo-nota-1 > p:nth-of-type(11) {
    grid-column: 3;
    border-top: 1px solid #111;
    margin-top: 20px;
    padding-top: 15px;
  }

  /* 4. ESTILOS TIPOGRÁFICOS INTERNOS DEL MARKDOWN */
  .cuerpo-nota-1 h2 {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.2rem;
    border-bottom: 2px solid #111;
    padding-bottom: 4px;
    margin-bottom: 12px;
    color: #111;
  }

  .cuerpo-nota-1 p {
    font-size: 1.05rem;
    line-height: 1.45;
    text-align: justify;
    margin-bottom: 14px;
  }

  /* Párrafo destacado (Lead Inicial) */
  .cuerpo-nota-1 > p:first-of-type {
    font-size: 1.15rem;
    font-weight: bold;
    line-height: 1.4;
  }

  .etiqueta-tiempo {
    font-family: monospace;
    font-size: 0.85rem;
    border: 1px solid #111;
    padding: 2px 6px;
    text-transform: uppercase;
    display: inline-block;
  }

  /* 5. DISEÑO RESPONSIVO (Se colapsa fluidamente en smartphones) */
  @media (max-width: 1024px) {
    .diario-cronica-container, .cuerpo-nota-1 {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .cuerpo-nota-1 > p, .cuerpo-nota-1 > h2 {
      grid-column: 1 !important;
    }
    .cuerpo-nota-1 > h2:nth-of-type(2) {
      border-left: none;
      border-right: none;
      padding: 0;
    }
    .cuerpo-nota-1 > h2:nth-of-type(4) {
      border-top: 1px solid #111;
    }
  }
</style>
