---
const { content, frontmatter } = Astro.props;
const data = content || frontmatter;

import MenuNav from "../components/MenuNav.astro";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{data.titulo}</title>

  <!-- 1. CARGAMOS TUS ESTILOS DE LA PÁGINA PRINCIPAL (Para heredar colores y fuentes) -->
  <link rel="stylesheet" href="../../public/css/diario />

  <!-- 2. CARGAMOS EL DISEÑO DE TRES COLUMNAS PERIODÍSTICAS -->
  <link rel="stylesheet" href="../../public/css/diario" />
</head>
<body>
  

  <MenuNav />

  <main class="diario-cronica-container">
    <section class="columna-principal-nota">
      <div class="cabecera-nota">
        <span class="etiqueta-tiempo">{data.fechaEtiqueta}</span>
        <h1>{data.titulo}</h1>
      </div>
      
      <div class="contenedor-imagen-boceto">
        <img src={'/' + data.imagen} alt={data.titulo} />
      </div>

      <div class="cuerpo-nota-1">
        <slot />
      </div>
    </section>
  </main>

</body>
</html>