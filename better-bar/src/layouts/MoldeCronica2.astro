---
import MenuNav from "../components/MenuNav.astro";
import Footer from "../components/Footer.astro";
const { frontmatter } = Astro.props;

---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dagger Racing News - {frontmatter.titulo}</title>
    <link rel="stylesheet" href="/css/styless.css">
    <link rel="icon" type="image/png" href="/daggerracingnews-logotipo.png">
</head>
<body>

    <MenuNav />

    <main class="container">
        
        <!-- COLUMNA IZQUIERDA: LA NOTICIA COMPLETA -->
        <section class="noticias">
            <article class="tarjeta-noticia" style="border-left: 4px solid #e10600; padding-left: 15px;">
                
                <!-- SECCIÓN MOVIDA: FECHA Y TITULAR ARRIBA DE LA IMAGEN PRINCIPAL -->
                <div class="contenido-cabecera" style="margin-bottom: 15px;">
                    <span class="fecha">{frontmatter.fechaEtiqueta}</span>
                    <h2 class="titular-cronica" style="font-size: 1.8rem; margin: 10px 0 20px 0; line-height: 1.3;">{frontmatter.titulo}</h2>
                </div>

                <div class="contenedor-imagen-live" style="height: 400px; margin-bottom: 20px;">
                    <img src={`/${frontmatter.imagen}`} alt="Monoplaza en pista" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                
                 {frontmatter.credito && (
                    <div style="text-align: right; width: 100%; margin-top: 5px; margin-bottom: 15px;">
                        <span style="font-size: 11px; color: #b3b3b3; font-style: italic; font-family: Arial, sans-serif;">
                            Foto: {frontmatter.credito}
                        </span>
                    </div>
                )}
                
                <div class="contenido">
                    <!-- Aquí Astro inyectará automáticamente los párrafos y tablas de tus archivos .md -->
                    <slot />

                    <!-- TU BOTÓN AZUL OSCURO REAL INTEGRADO -->
                    <button id="btn-desplegar-tabla" class="boton-desplegar" style="display: block; width: 100%; background-color: #1e293b; color: white; border: none; padding: 12px; font-family: 'Orbitron', sans-serif; cursor: pointer; text-align: center; font-size: 0.9rem; margin-top: 20px; margin-bottom: 20px; font-weight: bold;">
                        Ver resto de posiciones ↓
                    </button>
                    
                    <br>
                    <a href="/" class="boton-leer">VOLVER AL INICIO</a>
                </div>
            </article>
        </section>

        <!-- COLUMNA DERECHA CORREGIDA: MISMA ESTRUCTURA E IDENTIDAD DE LA PÁGINA PRINCIPAL -->
        <aside class="barra-lateral-derecha">
            <div class="seccion-proxima">
                <h3>Crónicas Anteriores</h3>
                <div class="evento">
                    <p><strong>Artículos recomendados</strong></p>
                    <p>No te pierdas las últimas novedades</p>
                </div>
            </div>

            <div class="seccion-horarios">
                <h4>Más Noticias</h4>
                <div class="tabla-horarios">
                    
                    <!-- Tarjeta de Crónica 1 -->
                    <div class="fila-paises" style="margin-bottom: 12px; padding: 12px;">
                        <div class="horarios">
                            <a href="/noticias/hamilton-ganabarcelona-2026" style="text-decoration: none; color: inherit; display: block;">
                                <span style="font-size: 0.75rem; color: #888; display: block; margin-bottom: 4px;">⏱️ 14 de junio, 2026</span>
                                <p class="carrera" style="font-size: 0.95rem; font-weight: bold; line-height: 1.3; color: #111; margin: 0;">
                                    ¡ÉPICA EN BARCELONA! HAMILTON REINA EN EL CAOS
                                </p>
                            </a>
                        </div>
                    </div>

                    <!-- Tarjeta de Crónica 2 -->
                    <div class="fila-paises" style="margin-bottom: 12px; padding: 12px;">
                        <div class="horarios">
                            <a href="/noticias/2026-06-13-clasificacion-barcelona" style="text-decoration: none; color: inherit; display: block;">
                                <span style="font-size: 0.75rem; color: #888; display: block; margin-bottom: 4px;">⏱️ 13 de junio, 2026</span>
                                <p class="carrera" style="font-size: 0.95rem; font-weight: bold; line-height: 1.3; color: #111; margin: 0;">
                                    Thrill en Montmeló: George Russell firma la pole en Barcelona
                                </p>
                            </a>
                        </div>
                    </div>

                    <!-- Tarjeta de Crónica 3 -->
                    <div class="fila-paises" style="margin-bottom: 12px; padding: 12px;">
                        <div class="horarios">
                            <a href="/noticias/cronica-russell" style="text-decoration: none; color: inherit; display: block;">
                                <span style="font-size: 0.75rem; color: #888; display: block; margin-bottom: 4px;">⏱️ 13 de junio, 2026</span>
                                <p class="carrera" style="font-size: 0.95rem; font-weight: bold; line-height: 1.3; color: #111; margin: 0;">
                                    Mercedes no da tregua: Russell lidera una calurosa FP3
                                </p>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </aside>
        
    </main>

    <!-- CONTENEDOR ANCLADO DESDE COMPLEMENTS -->
    <Footer />

    <!-- INTERACTIVIDAD DE DESPLEGUE SANEADA -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const boton = document.getElementById("btn-desplegar-tabla");
            const tablaOculta = document.querySelector(".filas-tabla-ocultas");

            if (tablaOculta && boton) {
                tablaOculta.style.display = "none";
                
                boton.addEventListener("click", () => {
                    if (tablaOculta.style.display === "none") {
                        tablaOculta.style.display = "block";
                        boton.textContent = "Ocultar posiciones ↑";
                    } else {
                        tablaOculta.style.display = "none";
                        boton.textContent = "Ver resto de posiciones ↓";
                    }
                });
            } else {
                if (boton) boton.style.display = "none";
            }
        });
    </script>

</body>
</html>