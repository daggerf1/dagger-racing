<style>

	:root {
		--bg-principal: #ffffff;
		--rojo-racing: #e10600;
		--texto-puro: #0f172a;
		--texto-secundario: #475569;
		--borde-tecnico: #e2e8f0;
	}

	body {
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
    margin: 0;
    padding: 0;
