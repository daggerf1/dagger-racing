<style>
	:root {
		--bg-principal: #ffffff;
		--rojo-racing: #e10600;
		--texto-puro: #0f172a;
		--texto-secundario: #475569;
		--borde-tecnico: #e2e8f0;
	}

	body {
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #fcfcfd;
    color: #334155;
    -webkit-font-smoothing: antialiased;
}

header {
    background: #09090b;
    border-bottom: 3px solid #e10600;
    text-align: center;
    padding: 14px 0 10px 0;
}

header h1 {
    font-family: 'Segoe UI', -apple-system, sans-serif;
    font-style: normal;
    font-size: 18px;
    margin: 0 0 4px 0;
    color: #ffffff;
    letter-spacing: 3px;
    text-shadow: none;
    font-weight: 700;
    text-transform: uppercase;
}

header h1 span {
    color: #e10600;
    margin-left: 4px;
    font-style: normal;
}


header p {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 12px 0;
    color: #71717a;
    font-weight: 500;
}

header nav a {
    color: #a1a1aa;
    text-decoration: none;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    transition: color 0.2s ease;
}

.legal-container {
    max-width: 740px;
    margin: 50px auto;
    padding: 0 20px;
    background: transparent; 
    box-shadow: none; 
}

.legal-container h2 {
    font-family: 'Segoe UI', -apple-system, sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: #09090b;
    border-left: 3px solid #e10600;
    padding-left: 12px;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.legal-content {
    font-size: 15px;
    line-height: 1.75;
    color: #27272a;
}

.legal-content h3 {
    font-size: 16px;
    font-weight: 600;
    color: #09090b;
    margin-top: 30px;
    margin-bottom: 8px;
    letter-spacing: 0px;
}