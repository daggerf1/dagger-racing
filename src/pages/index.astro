---
const notasCargadas = import.meta.glob('./noticias/*.md', { eager: true });
// Ordenamos cronológicamente de mayor a menor por el nombre de archivo (Fechas más nuevas primero)
const todasLasCronicas = Object.values(notasCargadas).sort((a, b) => {
    const nameA = a.file.split('/').pop();
    const nameB = b.file.split('/').pop();
    return nameB.localeCompare(nameA);
});

// La más nueva toma el trono grande, las demás van abajo al carrusel interactivo
const noticiaPrincipal = todasLasCronicas[0];
const notasSecundarias = todasLasCronicas.slice(1);
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dagger Racing - Noticias de Fórmula 1</title>
<link rel="stylesheet" href="/css/styless.css">
</head>
<body>

<header>
<h1>DAGGER RACING</h1>
<p>noticias de la máxima categoría</p>
</header>

<nav>
<a href="/">Inicio</a>
<a href="#">Noticias</a>
<a href="#">Calendario</a>
<a href="#">Posiciones</a>
</nav>

<!-- CONTENEDOR SEGURO QUE CALIBRA LA BARRA LATERAL PARA QUE NO SE DESAPAREZCA -->
<main class="container" style="display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 25px; max-width: 1200px; margin: 0 auto; padding: 20px; box-sizing: border-box; width: 100%;">

<!-- COLUMNA IZQUIERDA: NOTICIAS -->
<div class="bloque-izquierdo" style="display: flex; flex-direction: column; gap: 40px; overflow: hidden; width: 100%;">
    
    <!-- 1. NOTICIA PRINCIPAL (GRANDE ARRIBA) -->
    {noticiaPrincipal && (
        <section class="noticia-destacada" style="background: #1a1a1a; border-radius: 8px; overflow: hidden; border: 1px solid #333; width: 100%;">
            <div class="contenedor-imagen-live" style="position: relative; height: 420px; width: 100%;">
                <img src={`/${noticiaPrincipal.frontmatter.imagen}`} alt="Noticia Principal" style="width: 100%; height: 100%; object-fit: cover;">
                
                {noticiaPrincipal.frontmatter.credito && (
                    <div style="text-align: right; width: 100%; position: absolute; bottom: 5px; right: 10px; z-index: 5;">
                        <span style="font-size: 11px; color: #b3b3b3; font-style: italic; font-family: Arial, sans-serif;">
                            Foto: {noticiaPrincipal.frontmatter.credito}
                        </span>
                    </div>
                )}
            </div>
            <div class="contenido" style="padding: 25px;">
                <span class="fecha" style="color: #e10600; font-weight: bold; font-family: 'Orbitron', sans-serif; display: inline-block; margin-bottom: 10px;">{noticiaPrincipal.frontmatter.fechaEtiqueta}</span>
                <h2 style="font-size: 2rem; margin: 0 0 15px 0; font-family: 'Orbitron', sans-serif; color: white; line-height: 1.2;">{noticiaPrincipal.frontmatter.titulo}</h2>
                <a href={noticiaPrincipal.url} class="boton-leer" style="display: inline-block; background: #e10600; color: white; padding: 12px 24px; text-decoration: none; font-weight: bold; border-radius: 4px; font-family: 'Orbitron', sans-serif;">LEER CRÓNICA COMPLETA</a>
            </div>
        </section>
    )}

    <!-- 2. NOTICIAS SECUNDARIAS CON BOTONES INTERACTIVOS DE CONTROL -->
    <section class="noticias-secundarias-contenedor" style="width: 100%; position: relative;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid #333; padding-bottom: 10px;">
            <h3 style="font-family: 'Orbitron', sans-serif; color: white; margin: 0;">Crónicas Anteriores</h3>
            
            <!-- CONTROLES MANUALES FLOTANTES PARA MOVER LAS NOTAS -->
            <div style="display: flex; gap: 8px;">
                <button id="slide-atras" style="background: #222; color: white; border: 1px solid #444; width: 35px; height: 35px; border-radius: 4px; cursor: pointer; font-weight: bold; font-family: monospace;">&lt;</button>
                <button id="slide-adelante" style="background: #222; color: white; border: 1px solid #444; width: 35px; height: 35px; border-radius: 4px; cursor: pointer; font-weight: bold; font-family: monospace;">&gt;</button>
            </div>
        </div>
        
        <!-- CARRUSEL HORIZONTAL CON LA BARRA GRIS ABAJO -->
        <div id="contenedor-carrusel" style="display: flex; gap: 20px; overflow-x: auto; padding-bottom: 15px; scrollbar-color: #555 #222; scrollbar-width: thin; scroll-behavior: smooth; width: 100%;">
            
            {notasSecundarias.map((nota) => (
                <article class="tarjeta-chica" style="flex: 0 0 240px; background: #111; border-radius: 6px; overflow: hidden; border: 1px solid #222; display: flex; flex-direction: column;">
                    <div style="height: 140px; width: 100%; position: relative;">
                        <img src={`/${nota.frontmatter.imagen}`} alt="Imagen noticia" style="width: 100%; height: 100%; object-fit: cover;">
                        {nota.frontmatter.credito && (
                            <div style="text-align: right; width: 100%; position: absolute; bottom: 4px; right: 8px; z-index: 5;">
                                <span style="font-size: 9px; color: #b3b3b3; font-style: italic; font-family: Arial, sans-serif;">
                                    Foto: {nota.frontmatter.credito}
                                </span>
                            </div>
                        )}
                    </div>
                    <div style="padding: 12px; display: flex; flex-direction: column; flex-grow: 1;">
                        <span style="font-size: 0.75rem; color: #e10600; font-weight: bold; margin-bottom: 5px; display: inline-block;">{nota.frontmatter.fechaEtiqueta}</span>
                        <h4 style="font-size: 0.95rem; margin: 0 0 15px 0; font-family: 'Orbitron', sans-serif; color: white; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{nota.frontmatter.titulo}</h4>
                        <a href={nota.url} style="margin-top: auto; color: #aaa; text-decoration: none; font-weight: bold; font-size: 0.85rem;">Leer Más →</a>
                    </div>
                </article>
            ))}

        </div>
    </section>

</div>

<!-- COLUMNA DERECHA: LA BARRA LATERAL AJUSTADA -->
<aside class="barra-lateral" style="background: #141414; padding: 15px; border-radius: 8px; border: 1px solid #333; height: fit-content; min-width: 320px; box-sizing: border-box;">
<h3 style="font-family: 'Orbitron', sans-serif; font-size: 1.1rem; color: white; margin-top: 0;">Próxima Carrera</h3>
<div class="evento" style="background: #222; padding: 10px; border-radius: 4px; margin-bottom: 15px; border-left: 3px solid #e10600;">
    <p style="margin: 0 0 5px 0;"><strong>Gran Premio de España</strong></p>
    <p style="margin: 0; font-size: 0.85rem; color: #aaa;">Circuito de Barcelona-Cataluña</p>
</div>

<h4 style="font-family: 'Orbitron', sans-serif; font-size: 1rem; color: white; margin-bottom: 10px;">Horarios del Fin de Semana</h4>
<div class="tabla-horarios" style="display: flex; flex-direction: column; gap: 12px;">
    
    <div class="fila-paises">
        <span class="paises">🇦🇷 🇧🇷 🇵🇾 🇺🇾</span>
        <div class="horarios">
            <p><span>Práctica 1:</span>Viernes 12 – 08:30</p>
            <p><span>Práctica 2:</span>Viernes 12 – 12:00</p>
            <p><span>Práctica 3:</span>Sábado 13 – 07:30</p>
            <p><span>Clasificación:</span> Sábado 13 – 11:00</p>
            <p class="carrera"><span>Gran Premio:</span> Domingo 14 – 10:00</p>
        </div>
    </div>

    <div class="fila-paises">
        <span class="paises">🇧🇴 🇨🇱 🇩🇴 🇵🇷 🇻🇪</span>
        <div class="horarios">
            <p><span>Práctica 1:</span> Viernes 12 – 07:30</p>
            <p><span>Práctica 2:</span> Viernes 12 – 11:00</p>
            <p><span>Práctica 3:</span> Sábado 13 – 06:30</p>
            <p><span>Clasificación:</span> Sábado 13 – 10:00</p>
            <p class="carrera"><span>GP:</span> Domingo 14 – 09:00</p>
        </div>
    </div>

    <div class="fila-paises">
        <span class="paises">🇨🇴 🇪🇨 🇵🇦 🇵🇪</span>
        <div class="horarios">
            <p><span>Práctica 1:</span> Viernes 12 – 06:30</p>
            <p><span>Práctica 2:</span> Viernes 12 – 10:00</p>
            <p><span>Práctica 3:</span> Sábado 13 – 05:30</p>
            <p><span>Clasificación:</span> Sábado 13 – 09:00</p>
            <p class="carrera"><span>GP:</span> Domingo 14 – 08:00</p>
        </div>
    </div>

    <div class="fila-paises">
        <span class="paises">🇨🇷 🇸🇻 🇭🇳 🇲🇽</span>
        <div class="horarios">
            <p><span>Práctica 1:</span> Viernes 12 – 05:30</p>
            <p><span>Práctica 2:</span> Viernes 12 – 09:00</p>
            <p><span>Práctica 3:</span> Sábado 13 – 04:30</p>
            <p><span>Clasificación:</span> Sábado 13 – 08:00</p>
            <p class="carrera"><span>GP:</span> Domingo 14 – 07:00</p>
        </div>
    </div>
</div>
</aside>

</main>

<footer>
<p>&copy; 2026 Dagger Racing. Todos los derechos reservados.</p>
</footer>

<!-- SCRIPT DE INTERACTIVIDAD PARA HACER QUE LOS BOTONES MUEVAN EL CARRUSEL -->
<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
    const carrusel = document.getElementById("contenedor-carrusel");
    const btnAtras = document.getElementById("slide-atras");
    const btnAdelante = document.getElementById("slide-adelante");

    if (carrusel && btnAtras && btnAdelante) {
        btnAdelante.addEventListener("click", () => {
            carrusel.scrollLeft += 260; // Avanza el ancho de una tarjeta
        });
        btnAtras.addEventListener("click", () => {
            carrusel.scrollLeft -= 260; // Retrocede el ancho de una tarjeta
        });
    }
});
</script>

</body>
</html>