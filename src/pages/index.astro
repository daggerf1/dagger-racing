---
const notasCargadas = import.meta.glob('./noticias/*.md', { eager: true });
// Ordenamos cronológicamente de mayor a menor por nombre de archivo
const todasLasCronicas = Object.values(notasCargadas).sort((a, b) => {
    return b.file.split('/').pop().localeCompare(a.file.split('/').pop());
});

// Separamos: la primera va al espacio grande, las demás van abajo
const noticiaPrincipal = todasLasCronicas[0];
const notasSecundarias = todasLasCronicas.slice(1);
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dagger Racing - Noticias de Fórmula 1</title>
<link rel="stylesheet" href="/css/styless.css">
</head>
<body>

<header>
<h1>DAGGER RACING</h1>
<p>noticias de la máxima categoría</p>
</header>

<nav>
<a href="/">Inicio</a>
<a href="#">Noticias</a>
<a href="#">Calendario</a>
<a href="#">Posiciones</a>
</nav>

<main class="container" style="display: grid; grid-template-columns: 1fr 350px; gap: 30px; max-width: 1200px; margin: 0 auto; padding: 20px;">

    <!-- COLUMNA IZQUIERDA: NOTICIAS -->
    <div class="bloque-izquierdo" style="display: flex; flex-direction: column; gap: 40px;">
        
        <!-- 1. NOTICIA PRINCIPAL (GRANDE ARRIBA) -->
        {noticiaPrincipal && (
            <section class="noticia-destacada" style="background: #1a1a1a; border-radius: 8px; overflow: hidden; border: 1px solid #333;">
                <div class="contenedor-imagen-live" style="position: relative; height: 450px; width: 100%;">
                    <img src={`/${noticiaPrincipal.frontmatter.imagen}`} alt="Noticia Principal" style="width: 100%; height: 100%; object-fit: cover;">
                    
                    <!-- Flecha interactiva derecha decorativa -->
                    <div style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.7); color: white; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; cursor: pointer; font-weight: bold; border: 1px solid #444;">
                        &gt;
                    </div>

                    {noticiaPrincipal.frontmatter.credito && (
                        <div style="text-align: right; width: 100%; position: absolute; bottom: 5px; right: 10px;">
                            <span style="font-size: 11px; color: #b3b3b3; font-style: italic; font-family: Arial, sans-serif;">
                                Foto: {noticiaPrincipal.frontmatter.credito}
                            </span>
                        </div>
                    )}
                </div>
                <div class="contenido" style="padding: 25px;">
                    <span class="fecha" style="color: #e10600; font-weight: bold; font-family: 'Orbitron', sans-serif;">{noticiaPrincipal.frontmatter.fechaEtiqueta}</span>
                    <h2 style="font-size: 2.2rem; margin: 15px 0; font-family: 'Orbitron', sans-serif; color: white; line-height: 1.2;">{noticiaPrincipal.frontmatter.titulo}</h2>
                    <p style="color: #ccc; font-size: 1.1rem; line-height: 1.6; margin-bottom: 20px;">{noticiaPrincipal.frontmatter.resumenRapido}</p>
                    <a href={noticiaPrincipal.url} class="boton-leer" style="display: inline-block; background: #e10600; color: white; padding: 12px 24px; text-decoration: none; font-weight: bold; border-radius: 4px; font-family: 'Orbitron', sans-serif;">Leer Crónica Completa</a>
                </div>
            </section>
        )}

        <!-- 2. NOTICIAS SECUNDARIAS (FILA DE ABAJO #1, #2, #3...) -->
        <section class="noticias-secundarias-contenedor" style="width: 100%;">
            <h3 style="font-family: 'Orbitron', sans-serif; color: white; margin-bottom: 20px; border-bottom: 2px solid #333; padding-bottom: 10px;">Crónicas Anteriores</h3>
            
            <!-- Contenedor con barra gris de desplazamiento horizontal para que exploren -->
            <div class="scroll-noticias" style="display: flex; gap: 20px; overflow-x: auto; padding-bottom: 15px; scrollbar-color: #555 #222; scrollbar-width: thin;">
                
                {notasSecundarias.map((nota) => (
                    <article class="tarjeta-chica" style="flex: 0 0 280px; background: #111; border-radius: 6px; overflow: hidden; border: 1px solid #222; display: flex; flex-direction: column;">
                        <div style="height: 150px; width: 100%; position: relative;">
                            <img src={`/${nota.frontmatter.imagen}`} alt="Imagen noticia" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <div style="padding: 15px; display: flex; flex-direction: column; flex-grow: 1;">
                            <span style="font-size: 0.8rem; color: #aaa; margin-bottom: 5px;">{nota.frontmatter.fechaEtiqueta}</span>
                            <h4 style="font-size: 1rem; margin: 0 0 15px 0; font-family: 'Orbitron', sans-serif; color: white; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{nota.frontmatter.titulo}</h4>
                            <a href={nota.url} style="margin-top: auto; color: #e10600; text-decoration: none; font-weight: bold; font-size: 0.9rem;">Leer Más →</a>
                        </div>
                    </article>
                ))}

            </div>
        </section>

    </div>

    <!-- COLUMNA DERECHA: HORARIOS (TU ASIDE COMPLETO) -->
    <aside class="barra-lateral" style="background: #141414; padding: 20px; border-radius: 8px; border: 1px solid #333; height: fit-content;">
        <h3>Próxima Carrera</h3>
        <div class="evento">
            <p><strong>Gran Premio de España</strong></p>
            <p>Circuito de Barcelona-Cataluña</p>
        </div>

        <h4>Horarios del Fin de Semana</h4>
        <div class="tabla-horarios">
            <!-- Pega aquí dentro tal cual tus bloques de países con banderas de tu aside original -->
            <div class="fila-paises">
                <span class="paises">🇦🇷 🇧🇷 🇵🇾 🇺🇾</span>
                <div class="horarios">
                    <p><span>Práctica 1:</span>Viernes 12 – 08:30</p>
                    <p><span>Práctica 2:</span>Viernes 12 – 12:00</p>
                    <p><span>Práctica 3:</span>Sábado 13 – 07:30</p>
                    <p><span>Clasificación:</span> Sábado 13 – 11:00</p>
                    <p class="carrera"><span>Gran Premio:</span> Domingo 14 – 10:00</p>
                </div>
            </div>
            <!-- ... Los demás países que ya tienes en tu código actual ... -->
        </div>
    </aside>

</main>

<footer>
<p>&copy; 2026 Dagger Racing. Todos los derechos reservados.</p>
</footer>

</body>
</html>