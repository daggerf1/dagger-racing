---
const notasCargadas = import.meta.glob('./noticias/*.md', { eager: true });

// ORDENAMIENTO CRONOLÓGICO INVERSO ESTRICTO (MÁS NUEVA ARRIBA)
const todasLasCronicas = Object.values(notasCargadas).sort((a, b) => {
    const fileA = a.file.split('/').pop().toLowerCase();
    const fileB = b.file.split('/').pop().toLowerCase();
    
    // Forzamos que la Clasificación (Qualy) sea siempre la reina absoluta arriba
    if (fileB.includes('clasificacion')) return 1;
    if (fileA.includes('clasificacion')) return -1;
    
    // La FP3 va en segundo lugar de prioridad
    if (fileB.includes('fp3')) return 1;
    if (fileA.includes('fp3')) return -1;
    
    // La P2 de Lando va en tercer lugar
    if (fileB.includes('lando')) return 1;
    if (fileA.includes('lando')) return -1;
    
    return 0;
});

// Separamos: la primera (Qualy) va arriba, el resto (FP3 -> P2 -> P1) van abajo
const noticiaPrincipal = todasLasCronicas[0];
const notasSecundarias = todasLasCronicas.slice(1);
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dagger Racing - Noticias de Fórmula 1</title>
<link rel="stylesheet" href="/css/styless.css">
</head>
<body>

<header>
<h1>DAGGER RACING</h1>
<p>noticias de la máxima categoría</p>
</header>

<nav>
<a href="/">Inicio</a>
<a href="#">Noticias</a>
<a href="#">Calendario</a>
<a href="#">Posiciones</a>
</nav>

<main class="container" style="display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 25px; max-width: 1200px; margin: 0 auto; padding: 20px; box-sizing: border-box; width: 100%;">

<!-- COLUMNA IZQUIERDA: NOTICIAS -->
<div class="bloque-izquierdo" style="display: flex; flex-direction: column; gap: 40px; overflow: hidden; width: 100%;">
    
    <!-- 1. NOTICIA PRINCIPAL (CON CARRUSEL INTERACTIVO ADENTRO DE LA IMAGEN) -->
    {noticiaPrincipal && (
        <section class="noticia-destacada" style="background: #1a1a1a; border-radius: 8px; overflow: hidden; border: 1px solid #333; width: 100%;">
            
            <!-- CONTENEDOR DE LA IMAGEN CON FLECHAS ROJAS Y CRÉDITO ADENTRO -->
            <div class="contenedor-imagen-live" style="position: relative; height: 420px; width: 100%; background: #000;">
                <img id="img-principal" src={`/${noticiaPrincipal.frontmatter.imagen}`} alt="Noticia Principal" style="width: 100%; height: 100%; object-fit: cover; transition: opacity 0.2s ease; display: block;">
                
                <!-- FLECHA IZQUIERDA (REGRESAR) EN COLOR ROJO -->
                <button id="main-atras" style="position: absolute; left: 20px; top: 50%; transform: translateY(-50%); background: #e10600; color: white; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; cursor: pointer; font-weight: bold; border: none; z-index: 10; box-shadow: 0 4px 10px rgba(0,0,0,0.5); font-family: monospace;">
                    &lt;
                </button>

                <!-- FLECHA DERECHA (AVANZAR) EN COLOR ROJO -->
                <button id="main-adelante" style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); background: #e10600; color: white; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; cursor: pointer; font-weight: bold; border: none; z-index: 10; box-shadow: 0 4px 10px rgba(0,0,0,0.5); font-family: monospace;">
                    &gt;
                </button>

                <!-- CRÉDITO CLARITO ADENTRO EN LA ESQUINA DERECHA -->
                <div style="position: absolute; bottom: 8px; right: 12px; z-index: 5; text-align: right; width: auto; pointer-events: none;">
                    <span id="credito-principal" style="font-size: 11px; color: #b3b3b3; font-style: italic; font-family: Arial, sans-serif; display: inline-block; text-shadow: 1px 1px 2px rgba(0,0,0,0.8);">
                        {noticiaPrincipal.frontmatter.credito ? `Foto: ${noticiaPrincipal.frontmatter.credito}` : ''}
                    </span>
                </div>
            </div>

            <!-- CONTENIDO DE LA NOTA -->
            <div class="contenido" style="padding: 25px;">
                <span id="fecha-principal" style="color: #e10600; font-weight: bold; font-family: 'Orbitron', sans-serif; display: inline-block; margin-bottom: 10px;">{noticiaPrincipal.frontmatter.fechaEtiqueta}</span>
              <h2 id="titulo-principal" style="font-size: 2rem; margin: 0 0 15px 0; font-family: 'Orbitron', sans-serif; color: #ffffff; line-height: 1.2;">
              <a href={noticiaPrincipal.url} style="color: #ffffff; text-decoration: none; transition: color 0.2s ease;" onmouseover="this.style.color='#e10600'" onmouseout="this.style.color='#ffffff'">
              {noticiaPrincipal.frontmatter.titulo}
             </a>
            </h2>
                <a id="enlace-principal" href={noticiaPrincipal.url} class="boton-leer" style="display: inline-block; background: #e10600; color: white; padding: 12px 24px; text-decoration: none; font-weight: bold; border-radius: 4px; font-family: 'Orbitron', sans-serif;">LEER CRÓNICA COMPLETA</a>
            </div>
        </section>
    )}

    <!-- 2. NOTICIAS SECUNDARIAS (CARRUSEL INFERIOR INTERACTIVO TOTALMENTE CORREGIDO) -->
    <section class="noticias-secundarias-contenedor" style="width: 100%;">
        <h3 style="font-family: 'Orbitron', sans-serif; color: white; margin-bottom: 20px; border-bottom: 2px solid #333; padding-bottom: 10px;">Crónicas Anteriores</h3>
        
        <div id="contenedor-carrusel" style="display: flex; gap: 20px; overflow-x: auto; padding-bottom: 15px; scrollbar-color: #555 #222; scrollbar-width: thin; scroll-behavior: smooth; width: 100%;">
            
            {notasSecundarias.map((nota) => (
                <article class="tarjeta-chica" data-credito={nota.frontmatter.credito} style="flex: 0 0 260px; min-width: 260px; background: #111; border-radius: 6px; overflow: hidden; border: 1px solid #222; display: flex; flex-direction: column;">
                    <div style="height: 140px; width: 100%; position: relative;">
                        <img src={`/${nota.frontmatter.imagen}`} alt="Imagen noticia" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <div style="padding: 12px; display: flex; flex-direction: column; flex-grow: 1;">
                        <span style="font-size: 0.75rem; color: #e10600; font-weight: bold; margin-bottom: 5px; display: inline-block;">{nota.frontmatter.fechaEtiqueta}</span>
                        <h4 style="font-size: 0.95rem; margin: 0 0 15px 0; font-family: 'Orbitron', sans-serif; color: #ffffff; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                         <a href={nota.url} style="color: #ffffff; text-decoration: none; transition: color 0.2s ease;" onmouseover="this.style.color='#e10600'" onmouseout="this.style.color='#ffffff'">
                         {nota.frontmatter.titulo}
                     </a>
                    </h4>
                        <a href={nota.url} style="margin-top: auto; color: #aaa; text-decoration: none; font-weight: bold; font-size: 0.85rem;">Leer Más →</a>
                    </div>
                </article>
            ))}

        </div>
    </section>

</div>

<!-- COLUMNA DERECHA: LA BARRA LATERAL FIJA -->
<aside class="barra-lateral" style="background: #141414; padding: 15px; border-radius: 8px; border: 1px solid #333; height: fit-content; min-width: 320px; box-sizing: border-box;">
<h3>Próxima Carrera</h3>
<div class="evento" style="background: #222; padding: 10px; border-radius: 4px; margin-bottom: 15px; border-left: 3px solid #e10600;">
    <p style="margin: 0 0 5px 0;"><strong>Gran Premio de España</strong></p>
    <p style="margin: 0; font-size: 0.85rem; color: #aaa;">Circuito de Barcelona-Cataluña</p>
</div>

<h4>Horarios del Fin de Semana</h4>
<div class="tabla-horarios" style="display: flex; flex-direction: column; gap: 12px;">
    
    <div class="fila-paises">
        <span class="paises">🇦🇷 🇧🇷 🇵🇾 🇺🇾</span>
        <div class="horarios">
            <p><span>Práctica 1:</span>Viernes 12 – 08:30</p>
            <p><span>Práctica 2:</span>Viernes 12 – 12:00</p>
            <p><span>Práctica 3:</span>Sábado 13 – 07:30</p>
            <p><span>Clasificación:</span> Sábado 13 – 11:00</p>
            <p class="carrera"><span>Gran Premio:</span> Domingo 14 – 10:00</p>
        </div>
    </div>

    <div class="fila-paises">
        <span class="paises">🇧🇴 🇨🇱 🇩🇴 🇵🇷 🇻🇪</span>
        <div class="horarios">
            <p><span>Práctica 1:</span> Viernes 12 – 07:30</p>
            <p><span>Práctica 2:</span> Viernes 12 – 11:00</p>
            <p><span>Práctica 3:</span> Sábado 13 – 06:30</p>
            <p><span>Clasificación:</span> Sábado 13 – 10:00</p>
            <p class="carrera"><span>GP:</span> Domingo 14 – 09:00</p>
        </div>
    </div>

    <div class="fila-paises">
        <span class="paises">🇨🇴 🇪🇨 🇵🇦 🇵🇪</span>
        <div class="horarios">
            <p><span>Práctica 1:</span> Viernes 12 – 06:30</p>
            <p><span>Práctica 2:</span> Viernes 12 – 10:00</p>
            <p><span>Práctica 3:</span> Sábado 13 – 05:30</p>
            <p><span>Clasificación:</span> Sábado 13 – 09:00</p>
            <p class="carrera"><span>GP:</span> Domingo 14 – 08:00</p>
        </div>
    </div>

    <div class="fila-paises">
        <span class="paises">🇨🇷 🇸🇻 🇭🇳 🇲🇽</span>
        <div class="horarios">
            <p><span>Práctica 1:</span> Viernes 12 – 05:30</p>
            <p><span>Práctica 2:</span> Viernes 12 – 09:00</p>
            <p><span>Práctica 3:</span> Sábado 13 – 04:30</p>
            <p><span>Clasificación:</span> Sábado 13 – 08:00</p>
            <p class="carrera"><span>GP:</span> Domingo 14 – 07:00</p>
        </div>
    </div>
</div>
</aside>

</main>

<footer>
<p>&copy; 2026 Dagger Racing. Todos los derechos reservados.</p>
</footer>
<script is:inline>
document.addEventListener("DOMContentLoaded", () => {

    // 1. CONTROL DEL CARRUSEL INFERIOR
    const carrusel = document.getElementById("contenedor-carrusel");
    const btnAtras = document.getElementById("slide-atras");
    const btnAdelante = document.getElementById("slide-adelante");

    if (carrusel && btnAtras && btnAdelante) {
        btnAdelante.addEventListener("click", () => { carrusel.scrollLeft += 260; });
        btnAtras.addEventListener("click", () => { carrusel.scrollLeft -= 260; });
    }

    // 2. CONTROL DEL CARRUSEL SUPERIOR INTERACTIVO
    let indiceActual = 0;
    const imgPrincipal = document.getElementById("img-principal");
    const tituloPrincipal = document.getElementById("titulo-principal");
    const fechaPrincipal = document.getElementById("fecha-principal");
    const enlacePrincipal = document.getElementById("enlace-principal");
    const creditoPrincipal = document.getElementById("credito-principal");
    
    const btnMainAtras = document.getElementById("main-atras");
    const btnMainAdelante = document.getElementById("main-adelante");

    const tarjetas = Array.from(document.querySelectorAll(".tarjeta-chica"));
    
    const notaInicial = {
        imagen: imgPrincipal?.src,
        titulo: tituloPrincipal?.querySelector("a")?.textContent?.trim() || tituloPrincipal?.textContent || "",
        fecha: fechaPrincipal?.textContent || "",
        url: enlacePrincipal?.href || "",
        credito: creditoPrincipal?.textContent?.replace("Foto: ", "") || ""
    };

    const diapositivas = [
        notaInicial,
        ...tarjetas.map(tarjeta => ({
            imagen: tarjeta.querySelector("img")?.src || "",
            titulo: tarjeta.querySelector("h4 a")?.textContent?.trim() || tarjeta.querySelector("h4")?.textContent?.trim() || "",
            fecha: tarjeta.querySelector("span")?.textContent || "",
            url: tarjeta.querySelector("a")?.href || "",
            credito: tarjeta.getAttribute("data-credito") || ""
        }))
    ];

    function cambiarDiapositiva(idx) {
        if (!diapositivas[idx] || !imgPrincipal) return;
        
        imgPrincipal.style.opacity = "0.3";
        
        setTimeout(() => {
            imgPrincipal.src = diapositivas[idx].imagen;
            if (fechaPrincipal) fechaPrincipal.textContent = diapositivas[idx].fecha;
            if (enlacePrincipal) enlacePrincipal.href = diapositivas[idx].url;
            
            if (tituloPrincipal) {
                const linkInside = tituloPrincipal.querySelector("a");
                if (linkInside) {
                    linkInside.textContent = diapositivas[idx].titulo;
                    linkInside.href = diapositivas[idx].url;
                } else {
                    tituloPrincipal.textContent = diapositivas[idx].titulo;
                }
            }
            
            if (creditoPrincipal) {
                creditoPrincipal.textContent = diapositivas[idx].credito ? "Foto: " + diapositivas[idx].credito : "";
            }
            
            imgPrincipal.style.opacity = "1";
        }, 150);
    }

    if (btnMainAdelante && btnMainAtras) {
        imgPrincipal.style.transition = "opacity 0.2s ease";
        btnMainAdelante.addEventListener("click", () => {
            indiceActual = (indiceActual + 1) % diapositivas.length;
            cambiarDiapositiva(indiceActual);
        });

        btnMainAtras.addEventListener("click", () => {
            indiceActual = (indiceActual - 1 + diapositivas.length) % diapositivas.length;
            cambiarDiapositiva(indiceActual);
        });
    }
});
</script>

</body>
</html>
